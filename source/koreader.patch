diff --git a/frontend/device/switch/device.lua b/frontend/device/switch/device.lua
new file mode 100644
index 000000000..58d80cb6a
--- /dev/null
+++ b/frontend/device/switch/device.lua
@@ -0,0 +1,189 @@
+local Event = require("ui/event")
+local Generic = require("device/generic/device")
+local ffi = require("ffi")
+local logger = require("logger")
+local _ = require("gettext")
+local C = ffi.C
+
+require("ffi/switch_h")
+require("ffi/linux_input_h") -- MSC_GYRO, for accelerometer rotation events
+
+local UIManager
+
+local function yes() return true end
+local function no() return false end
+
+-- c.f., `SetSysProductModel` in libnx.
+local MODELS = {
+    [1] = { name = "Nintendo Switch", dpi = 237 },      -- Erista (6.2" LCD)
+    [3] = { name = "Nintendo Switch", dpi = 237 },      -- Mariko (6.2" LCD)
+    [4] = { name = "Nintendo Switch Lite", dpi = 267 }, -- Hoag (5.5" LCD)
+    [6] = { name = "Nintendo Switch OLED", dpi = 210 }, -- Aula (7" OLED)
+}
+local model = MODELS[C.ko_get_product_model()] or MODELS[1]
+
+local OPERATION_MODE_DOCKED = 1
+
+local Device = Generic:extend{
+    model = model.name,
+    display_dpi = model.dpi,
+    isSwitch = yes,
+    home_dir = "/",
+    hasBattery = yes,
+    -- Touch screen only: Joy-Con aren't needed (or used), so the UI behaves like on a Kobo.
+    hasKeys = no,
+    hasDPad = no,
+    isTouchDevice = yes,
+    hasMultitouch = yes,
+    hasColorScreen = yes,
+    hasEinkScreen = no,
+    -- Night mode inverts the whole frame at scan-out (ko_fb_present), so let KOReader treat it as
+    -- hardware inversion: it keeps drawing normal pixels (fast C blitter) instead of the slow
+    -- per-pixel software-inversion blit, which has no JIT to lean on here.
+    canHWInvert = yes,
+    -- Auto-rotation from the accelerometer (Switch Lite always; regular/OLED only with Joy-Con attached).
+    -- KOReader's rotation menu, manual orientation and lock work regardless.
+    hasGSensor = yes,
+    hasFrontlight = yes,
+    hasWifiToggle = no,
+    hasSeamlessWifiToggle = no,
+    isDefaultFullscreen = yes,
+    needsScreenRefreshAfterResume = no,
+    canSuspend = no,
+    canStandby = no,
+    canPowerOff = no,
+    canReboot = no,
+    canRestart = yes,
+    -- There's no shell to run scripts with (and no way to spawn programs).
+    canExecuteScript = no,
+    -- SQLite's WAL mode needs shared memory mappings.
+    canUseWAL = no,
+}
+
+function Device:init()
+    self.screen = require("ffi/framebuffer_switch"):new{
+        device = self,
+        debug = logger.dbg,
+        -- Boot in the panel's native landscape orientation; the user rotates to portrait
+        -- with the accelerometer or the rotation menu (and can lock it there).
+    }
+    self.powerd = require("device/switch/powerd"):new{device = self}
+    self.input = require("device/input"):new{
+        device = self,
+        handleSdlEv = function(device_input, ev)
+            if ev.code == C.KO_SDL_QUIT then
+                -- Closed from the HOME menu: exit cleanly (saving the reading position, settings…).
+                logger.info("Switch: exit requested")
+                UIManager:broadcastEvent(Event:new("Close"))
+                UIManager:nextTick(function() UIManager:quit() end)
+            elseif ev.code == C.KO_SDL_OPERATION_MODE then
+                self:onOperationModeChanged(ev.value == OPERATION_MODE_DOCKED)
+            end
+        end,
+    }
+    -- Touch coordinates arrive in the panel's native (landscape) orientation, which now matches the
+    -- framebuffer's, so no axis swap is needed here; KOReader rotates them per the current rotation mode.
+
+    -- Accelerometer rotation: the native glue emits EV_MSC/MSC_GYRO; route it to the standard gyro
+    -- handler (Generic.init turns handleGyroEv into handleMiscGyroEv unless the user disabled it).
+    self.input.handleMiscEv = function(this, ev)
+        if ev.code == C.MSC_GYRO then
+            return this:handleGyroEv(ev)
+        end
+    end
+
+    -- Reading involves long stretches without input: don't let the console dim the screen or go to sleep.
+    C.ko_set_auto_sleep_inhibited(1)
+
+    -- Faster downloads: LuaSocket reads the network in 2 KiB blocks by default, and on the Switch
+    -- every read is an IPC round-trip to the system network service, so tiny blocks throttle large
+    -- downloads badly (~0.5 MB/s). Big blocks remove that ceiling (measured ~5 MB/s).
+    require("socket").BLOCKSIZE = 256 * 1024
+
+    Generic.init(self)
+end
+
+-- Keep comic/PDF pages in their original colours in night mode. Night mode inverts the whole screen;
+-- image widgets pre-invert themselves (so book covers look right), but paging documents (CBZ/CBR/PDF/
+-- DjVu) are drawn straight and would come out as negatives. Draw them pre-inverted (Document has an
+-- unused drawPageInverted) so the global inversion cancels out.
+-- NOTE: done here, not in init(): requiring readerview during Device:init() would loop, because
+-- readerview itself requires the (still-loading) device module.
+local function setup_nightmode_original_pages(screen)
+    local ReaderView = require("apps/reader/modules/readerview")
+    local function wrap(method_name)
+        local orig = ReaderView[method_name]
+        if type(orig) ~= "function" then return end
+        ReaderView[method_name] = function(rv, ...)
+            local doc = rv.document
+            if screen.night_mode and doc and doc.drawPageInverted then
+                local had_own = rawget(doc, "drawPage") -- nil when drawPage is a class method
+                doc.drawPage = doc.drawPageInverted     -- draw pre-inverted for this call
+                local ok, err = pcall(orig, rv, ...)
+                doc.drawPage = had_own                  -- restore (nil removes the shadow)
+                if not ok then error(err) end
+            else
+                return orig(rv, ...)
+            end
+        end
+    end
+    wrap("drawSinglePage")   -- single-page view
+    wrap("drawScrollPages")  -- continuous scroll view
+end
+
+function Device:onOperationModeChanged(docked)
+    -- A TV can't be turned sideways: use upright landscape while docked, and restore the previous rotation afterwards.
+    if docked then
+        self.handheld_rotation_mode = self.screen:getRotationMode()
+        UIManager:broadcastEvent(Event:new("SetRotationMode", self.screen.DEVICE_ROTATED_UPRIGHT))
+    elseif self.handheld_rotation_mode then
+        UIManager:broadcastEvent(Event:new("SetRotationMode", self.handheld_rotation_mode))
+        self.handheld_rotation_mode = nil
+    end
+end
+
+function Device:UIManagerReady(uimgr)
+    UIManager = uimgr
+    if not self._nightmode_pages_setup then
+        self._nightmode_pages_setup = true
+        -- Defer to the event loop: requiring readerview here (still inside startup module loading)
+        -- would hit a require loop; by the next tick every module has finished loading, and this
+        -- still runs long before the user can open a document.
+        local screen = self.screen
+        UIManager:nextTick(function() setup_nightmode_original_pages(screen) end)
+    end
+    if C.ko_get_operation_mode() == OPERATION_MODE_DOCKED then
+        UIManager:nextTick(function() self:onOperationModeChanged(true) end)
+    end
+    if C.ko_is_applet_mode() ~= 0 then
+        UIManager:scheduleIn(1, function()
+            local InfoMessage = require("ui/widget/infomessage")
+            UIManager:show(InfoMessage:new{
+                text = _("KOReader is running in applet mode, with limited memory: large documents may fail to open.\n\nFor best results, set up Atmosphère to open the Homebrew Menu when starting a game, and launch KOReader from there."),
+                timeout = 10,
+            })
+        end)
+    end
+end
+
+function Device:initNetworkManager(NetworkMgr)
+    function NetworkMgr:isWifiOn() return true end
+    function NetworkMgr:isConnected()
+        return C.ko_is_network_connected() ~= 0
+    end
+end
+
+function Device:retrieveNetworkInfo()
+    -- Network interfaces are managed by the system (no getifaddrs / raw sockets for homebrew).
+    if C.ko_is_network_connected() ~= 0 then
+        return _("Connected to the internet (network settings are managed by the console).")
+    end
+    return _("Not connected (network settings are managed by the console).")
+end
+
+function Device:exit()
+    C.ko_set_auto_sleep_inhibited(0)
+    Generic.exit(self)
+end
+
+return Device
diff --git a/frontend/device/switch/powerd.lua b/frontend/device/switch/powerd.lua
new file mode 100644
index 000000000..8a3ba3839
--- /dev/null
+++ b/frontend/device/switch/powerd.lua
@@ -0,0 +1,43 @@
+local BasePowerD = require("device/generic/powerd")
+local ffi = require("ffi")
+local C = ffi.C
+
+require("ffi/switch_h")
+
+local SwitchPowerD = BasePowerD:new{
+    fl_min = 0,
+    fl_max = 100,
+}
+
+function SwitchPowerD:frontlightIntensityHW()
+    local brightness = C.ko_get_brightness()
+    if brightness < 0 then
+        return self.fl_max
+    end
+    return math.floor(brightness * self.fl_max + 0.5)
+end
+
+function SwitchPowerD:setIntensityHW(intensity)
+    -- NOTE: the backlight can't be turned off, 0 is just the dimmest setting.
+    C.ko_set_brightness(intensity / self.fl_max)
+    self:_decideFrontlightState()
+end
+
+function SwitchPowerD:getCapacityHW()
+    local capacity = C.ko_get_battery_percentage()
+    if capacity >= 0 then
+        self.last_capacity = capacity
+    end
+    -- If the battery service hiccups, keep the last known level (rather than report an empty battery).
+    return self.last_capacity or 100
+end
+
+function SwitchPowerD:isChargingHW()
+    return C.ko_is_charging() ~= 0
+end
+
+function SwitchPowerD:isChargedHW()
+    return self:isChargingHW() and self:getCapacityHW() >= 100
+end
+
+return SwitchPowerD
diff --git a/frontend/document/doccache.lua b/frontend/document/doccache.lua
index e62ed780c..dde2bfbaf 100644
--- a/frontend/document/doccache.lua
+++ b/frontend/document/doccache.lua
@@ -66,7 +66,10 @@ function DocCache:serialize(doc_path)
     local cached_size = 0
     local sorted_caches = {}
     for _, file in pairs(self.cached) do
-        table.insert(sorted_caches, {file=file, time=lfs.attributes(file, "access")})
+        -- On some filesystems (e.g. the Switch's) lfs.attributes(..., "access") can be nil
+        -- (no access-time tracking, or the file was already evicted); default to 0 so the sort
+        -- below never compares a number with nil (which would abort serialization on exit).
+        table.insert(sorted_caches, {file=file, time=lfs.attributes(file, "access") or 0})
         cached_size = cached_size + (lfs.attributes(file, "size") or 0)
     end
     table.sort(sorted_caches, function(v1, v2) return v1.time > v2.time end)
diff --git a/frontend/ui/trapper.lua b/frontend/ui/trapper.lua
index ee64b461f..44d0188ea 100644
--- a/frontend/ui/trapper.lua
+++ b/frontend/ui/trapper.lua
@@ -503,6 +503,43 @@ function Trapper:dismissableRunInSubprocess(task, trap_widget_or_string, task_re
         logger.warn("unwrapped dismissableRunInSubprocess(), falling back to blocking in-process run")
         return true, task()
     end
+    if not ffiutil.isSubProcessSupported() then
+        -- No subprocesses on this platform: run the task in-process (it can't be dismissed).
+        local widget
+        if type(trap_widget_or_string) == "string" then
+            widget = TrapWidget:new{
+                text = trap_widget_or_string,
+            }
+            UIManager:show(widget)
+            UIManager:forceRePaint()
+        end
+        local results = table.pack(xpcall(task, debug.traceback))
+        if widget then
+            UIManager:close(widget)
+            UIManager:forceRePaint()
+        end
+        -- The UI was blocked meanwhile: drop the taps that piled up.
+        require("device").input:inhibitInputUntil(true)
+        -- Same results as with a subprocess: nothing if the task failed (like a crashed subprocess), or returned no output.
+        if not results[1] then
+            logger.warn("in-process task failed:", results[2])
+            return true
+        end
+        if task_returns_simple_string then
+            local result = results[2]
+            if type(result) ~= "string" then
+                if result ~= nil then
+                    logger.warn("returned value from task is not a string:", result)
+                end
+                return true
+            end
+            if result == "" then
+                return true
+            end
+            return true, result
+        end
+        return true, unpack(results, 2, results.n)
+    end
 
     local trap_widget
     local own_trap_widget = false
diff --git a/make/switch.mk b/make/switch.mk
new file mode 100644
index 000000000..cb1c01b6b
--- /dev/null
+++ b/make/switch.mk
@@ -0,0 +1,84 @@
+SWITCH_DIR = $(PLATFORM_DIR)/switch
+SWITCH_NRO = koreader-switch$(KODEDUG_SUFFIX)-$(VERSION).nro
+SWITCH_ROMFS = $(INSTALL_DIR)/romfs
+SWITCH_NACP = $(INSTALL_DIR)/koreader.nacp
+# NOTE: the NACP version field is limited to 16 characters (e.g. `v2026.07.2-161`).
+SWITCH_NACP_VERSION = $(subst $(space),-,$(wordlist 1,2,$(subst -, ,$(VERSION))))
+
+SWITCH_NSP = koreader-switch$(KODEDUG_SUFFIX)-$(VERSION).nsp
+SWITCH_NSP_DIR = $(INSTALL_DIR)/nsp
+# "KOREAD", in the application title ID range.
+SWITCH_TITLE_ID = 01004B4F52454144
+SWITCH_LANGUAGES = AmericanEnglish BritishEnglish Japanese French German LatinAmericanSpanish Spanish Italian \
+	Dutch CanadianFrench Portuguese Russian Korean TraditionalChinese SimplifiedChinese BrazilianPortuguese
+
+# Not useful / not supported on the Switch.
+define UPDATE_PATH_EXCLUDES +=
+koreader.elf
+switch
+plugins/SSH.koplugin
+plugins/autofrontlight.koplugin
+plugins/autowarmth.koplugin
+plugins/externalkeyboard.koplugin
+plugins/hello.koplugin
+plugins/terminal.koplugin
+plugins/timesync.koplugin
+tools
+endef
+
+# Update. {{{
+
+# The whole KOReader tree is embedded in the NRO's RomFS, and installed to
+# `/switch/koreader` on the SD card on first launch (c.f., `base/switch/main.c`).
+update: all
+	rm -rf $(SWITCH_ROMFS)
+	mkdir -p $(SWITCH_ROMFS)/koreader
+	rsync -a --copy-links \
+		$(foreach p,$(UPDATE_PATH_EXCLUDES),--exclude='/$p') \
+		$(foreach p,$(UPDATE_GLOBAL_EXCLUDES),--exclude='$p') \
+		$(INSTALL_DIR)/koreader/ $(SWITCH_ROMFS)/koreader/
+	# Identifies the embedded tree, so the launcher reinstalls it whenever it changes (c.f., `base/switch/install.c`).
+	cd $(SWITCH_ROMFS)/koreader && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1 > ../install-id
+	mv $(SWITCH_ROMFS)/install-id $(SWITCH_ROMFS)/koreader/.install-id
+	nacptool --create 'KOReader' 'KOReader community' '$(SWITCH_NACP_VERSION)' $(SWITCH_NACP)
+	elf2nro $(INSTALL_DIR)/koreader/koreader.elf $(SWITCH_NRO) \
+		--icon=$(SWITCH_DIR)/icon.jpg \
+		--nacp=$(SWITCH_NACP) \
+		--romfsdir=$(SWITCH_ROMFS)
+
+PHONY += update
+
+# }}}
+
+# Installable title (NSP). {{{
+
+# The same program, as an application with the RomFS inside: it gets its own HOME menu
+# icon, and a game's full memory. Building one needs hacbrewpack and the keys dumped from
+# your own console: `make TARGET=switch nsp SWITCH_KEYS=/path/to/prod.keys`.
+# NOTE: hacbrewpack only needs two of those keys, and rejects some entries of recent
+# keysets: it gets a private copy of just those two, removed right after.
+nsp: update
+	$(if $(SWITCH_KEYS),,$(error SWITCH_KEYS must point to the prod.keys dumped from your console))
+	rm -rf $(SWITCH_NSP_DIR)
+	mkdir -p $(SWITCH_NSP_DIR)/exefs $(SWITCH_NSP_DIR)/control
+	elf2nso $(INSTALL_DIR)/koreader/koreader.elf $(SWITCH_NSP_DIR)/exefs/main
+	npdmtool $(SWITCH_DIR)/koreader.json $(SWITCH_NSP_DIR)/exefs/main.npdm
+	nacptool --create 'KOReader' 'KOReader community' '$(SWITCH_NACP_VERSION)' \
+		$(SWITCH_NSP_DIR)/control/control.nacp --titleid=$(SWITCH_TITLE_ID)
+	$(SWITCH_DIR)/nsp_nacp.py $(SWITCH_NSP_DIR)/control/control.nacp
+	for lang in $(SWITCH_LANGUAGES); do cp $(SWITCH_DIR)/icon.jpg $(SWITCH_NSP_DIR)/control/icon_$$lang.dat; done
+	umask 077 && grep -E '^[[:space:]]*(header_key|key_area_key_application_00)[[:space:]]*=' '$(SWITCH_KEYS)' \
+		> $(SWITCH_NSP_DIR)/keys.txt || { echo "$(SWITCH_KEYS): no header_key / key_area_key_application_00" >&2; exit 1; }
+	hacbrewpack --keyset $(SWITCH_NSP_DIR)/keys.txt \
+		--titleid $(SWITCH_TITLE_ID) --titlename 'KOReader' --titlepublisher 'KOReader community' \
+		--exefsdir $(SWITCH_NSP_DIR)/exefs --romfsdir $(SWITCH_ROMFS) --controldir $(SWITCH_NSP_DIR)/control --nologo \
+		--tempdir $(SWITCH_NSP_DIR)/temp --ncadir $(SWITCH_NSP_DIR)/nca --backupdir $(SWITCH_NSP_DIR)/backup \
+		--nspdir $(SWITCH_NSP_DIR)/out; \
+		status=$$?; rm -f $(SWITCH_NSP_DIR)/keys.txt; exit $$status
+	mv $(SWITCH_NSP_DIR)/out/*.nsp $(SWITCH_NSP)
+
+PHONY += nsp
+
+# }}}
+
+# vim: foldmethod=marker foldlevel=0

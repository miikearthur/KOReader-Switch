diff --git a/platform/switch/nsp_nacp.py b/platform/switch/nsp_nacp.py
new file mode 100755
index 000000000..ae4a18cb8
--- /dev/null
+++ b/platform/switch/nsp_nacp.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""
+Adjust a `nacptool --create` NACP for KOReader's installable title (NSP).
+
+nacptool's defaults target NROs, whose NACP is mostly ignored. The HOME menu
+honors an installed title's NACP, so:
+- don't ask to pick a user account on launch (KOReader has no save data);
+- don't reserve user save data;
+- declare every language (the NSP ships the icon for each of them), with the
+  title and publisher set for all of them (nacptool and hacbrewpack only fill
+  the first 12 entries);
+- let the system dismiss the (absent) startup logo by itself.
+"""
+
+import struct
+import sys
+
+LANGUAGE_COUNT = 16
+TITLE_ENTRY_SIZE = 0x300  # name (0x200) + publisher (0x100)
+STARTUP_USER_ACCOUNT = 0x3025
+SUPPORTED_LANGUAGE_FLAG = 0x302C
+USER_ACCOUNT_SAVE_DATA_SIZE = 0x3080
+USER_ACCOUNT_SAVE_DATA_JOURNAL_SIZE = 0x3088
+LOGO_HANDLING = 0x30F1
+
+path = sys.argv[1]
+with open(path, "rb") as f:
+    nacp = bytearray(f.read())
+if len(nacp) != 0x4000:
+    sys.exit("%s: not a NACP" % path)
+
+for i in range(1, LANGUAGE_COUNT):
+    entry = i * TITLE_ENTRY_SIZE
+    if nacp[entry] == 0:
+        nacp[entry:entry + TITLE_ENTRY_SIZE] = nacp[0:TITLE_ENTRY_SIZE]
+nacp[STARTUP_USER_ACCOUNT] = 0  # None
+struct.pack_into("<Q", nacp, USER_ACCOUNT_SAVE_DATA_SIZE, 0)
+struct.pack_into("<Q", nacp, USER_ACCOUNT_SAVE_DATA_JOURNAL_SIZE, 0)
+struct.pack_into("<I", nacp, SUPPORTED_LANGUAGE_FLAG, 0xFFFF)
+nacp[LOGO_HANDLING] = 0  # Auto
+
+with open(path, "wb") as f:
+    f.write(nacp)

diff --git a/switch/compat/mman.c b/switch/compat/mman.c
new file mode 100644
index 00000000..8d07640e
--- /dev/null
+++ b/switch/compat/mman.c
@@ -0,0 +1,70 @@
+/*
+    Memory mappings: there is no mmap for homebrew. Anonymous mappings are
+    emulated with page-aligned allocations (since there's a single process,
+    shared ones are no different), anything else fails with ENOSYS.
+*/
+
+#include <errno.h>
+#include <malloc.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+
+void *mmap(void *addr, size_t length, int prot, int flags, int fd, off_t offset)
+{
+    (void)addr;
+    (void)prot;
+    (void)offset;
+    (void)fd;
+    if (!(flags & MAP_ANONYMOUS) || length == 0) {
+        errno = ENOSYS;
+        return MAP_FAILED;
+    }
+    void *p = memalign(4096, length);
+    if (!p) {
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    __builtin_memset(p, 0, length);
+    return p;
+}
+
+int munmap(void *addr, size_t length)
+{
+    (void)length;
+    free(addr);
+    return 0;
+}
+
+int mprotect(void *addr, size_t length, int prot)
+{
+    (void)addr;
+    (void)length;
+    (void)prot;
+    return 0;
+}
+
+int msync(void *addr, size_t length, int flags)
+{
+    (void)addr;
+    (void)length;
+    (void)flags;
+    return 0;
+}
+
+int madvise(void *addr, size_t length, int advice)
+{
+    (void)addr;
+    (void)length;
+    (void)advice;
+    return 0;
+}
+
+void *mremap(void *old_address, size_t old_size, size_t new_size, int flags, ...)
+{
+    (void)old_address;
+    (void)old_size;
+    (void)new_size;
+    (void)flags;
+    errno = ENOSYS;
+    return MAP_FAILED;
+}
diff --git a/switch/compat/posix_memalign.c b/switch/compat/posix_memalign.c
new file mode 100644
index 00000000..1e9b44e4
--- /dev/null
+++ b/switch/compat/posix_memalign.c
@@ -0,0 +1,16 @@
+/* `posix_memalign` (not provided by newlib). */
+
+#include <errno.h>
+#include <malloc.h>
+#include <stdlib.h>
+
+int posix_memalign(void **memptr, size_t alignment, size_t size)
+{
+    if (alignment < sizeof(void *) || (alignment & (alignment - 1)))
+        return EINVAL;
+    void *p = memalign(alignment, size);
+    if (!p)
+        return ENOMEM;
+    *memptr = p;
+    return 0;
+}
diff --git a/switch/compat/pread.c b/switch/compat/pread.c
new file mode 100644
index 00000000..ba04b958
--- /dev/null
+++ b/switch/compat/pread.c
@@ -0,0 +1,29 @@
+/* `pread` / `pwrite`, emulated with `lseek`. */
+
+#include <errno.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+ssize_t pread(int fd, void *buf, size_t count, off_t offset)
+{
+    off_t saved = lseek(fd, 0, SEEK_CUR);
+    if (saved < 0 || lseek(fd, offset, SEEK_SET) < 0)
+        return -1;
+    ssize_t ret = read(fd, buf, count);
+    int saved_errno = errno;
+    lseek(fd, saved, SEEK_SET);
+    errno = saved_errno;
+    return ret;
+}
+
+ssize_t pwrite(int fd, const void *buf, size_t count, off_t offset)
+{
+    off_t saved = lseek(fd, 0, SEEK_CUR);
+    if (saved < 0 || lseek(fd, offset, SEEK_SET) < 0)
+        return -1;
+    ssize_t ret = write(fd, buf, count);
+    int saved_errno = errno;
+    lseek(fd, saved, SEEK_SET);
+    errno = saved_errno;
+    return ret;
+}

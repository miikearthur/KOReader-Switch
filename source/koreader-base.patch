diff --git a/switch/compat/getaddrinfo.c b/switch/compat/getaddrinfo.c
new file mode 100644
index 00000000..b09b6047
--- /dev/null
+++ b/switch/compat/getaddrinfo.c
@@ -0,0 +1,29 @@
+/*
+    getaddrinfo: make sure each result carries a socket type.
+
+    The resolver can return results with `ai_socktype == 0` even when the caller asked for a
+    specific type in the hints. luasocket then does `socket(ai_family, ai_socktype, ai_protocol)`
+    with type 0, which the BSD layer rejects with EPROTOTYPE, so every connection fails. Copy the
+    requested type (default SOCK_STREAM) into any result that came back without one.
+    (Wired in with `-Wl,--wrap=getaddrinfo`.)
+*/
+
+#include <netdb.h>
+#include <sys/socket.h>
+
+int __real_getaddrinfo(const char *node, const char *service,
+                       const struct addrinfo *hints, struct addrinfo **res);
+
+int __wrap_getaddrinfo(const char *node, const char *service,
+                       const struct addrinfo *hints, struct addrinfo **res)
+{
+    int rc = __real_getaddrinfo(node, service, hints, res);
+    if (rc == 0 && res) {
+        int socktype = (hints && hints->ai_socktype) ? hints->ai_socktype : SOCK_STREAM;
+        for (struct addrinfo *ai = *res; ai; ai = ai->ai_next) {
+            if (ai->ai_socktype == 0)
+                ai->ai_socktype = socktype;
+        }
+    }
+    return rc;
+}
diff --git a/switch/compat/getcwd.c b/switch/compat/getcwd.c
new file mode 100644
index 00000000..9c7e31e1
--- /dev/null
+++ b/switch/compat/getcwd.c
@@ -0,0 +1,17 @@
+/*
+    `getcwd` returns paths prefixed with the device name (e.g. `sdmc:/switch/koreader`),
+    which the frontend does not expect. Since `sdmc` is the default device, strip it.
+    (Wired in with `-Wl,--wrap=getcwd`.)
+*/
+
+#include <stddef.h>
+
+char *__real_getcwd(char *buf, size_t size);
+
+char *__wrap_getcwd(char *buf, size_t size)
+{
+    char *cwd = __real_getcwd(buf, size);
+    if (cwd && __builtin_strncmp(cwd, "sdmc:/", 6) == 0)
+        __builtin_memmove(cwd, cwd + 5, __builtin_strlen(cwd + 5) + 1);
+    return cwd;
+}

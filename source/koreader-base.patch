+/*
+    KOReader for Nintendo Switch: <sys/termios.h> (included by newlib's <termios.h>).
+    There are no terminals: the functions fail with ENOTTY (c.f., `switch/compat/termios.c`).
+*/
+
+#ifndef KOSWITCH_SYS_TERMIOS_H
+#define KOSWITCH_SYS_TERMIOS_H
+
+#include <sys/types.h>
+
+typedef unsigned int tcflag_t;
+typedef unsigned char cc_t;
+typedef unsigned int speed_t;
+
+#define NCCS 32
+
+struct termios {
+    tcflag_t c_iflag;
+    tcflag_t c_oflag;
+    tcflag_t c_cflag;
+    tcflag_t c_lflag;
+    cc_t c_line;
+    cc_t c_cc[NCCS];
+    speed_t c_ispeed;
+    speed_t c_ospeed;
+};
+
+/* c_cc indexes. */
+#define VINTR    0
+#define VQUIT    1
+#define VERASE   2

diff --git a/switch/input.c b/switch/input.c
new file mode 100644
index 00000000..af712f86
--- /dev/null
+++ b/switch/input.c
@@ -0,0 +1,282 @@
+/*
+    KOReader for Nintendo Switch: input.
+
+    The port is operated with the touch screen only (no Joy-Con or controller buttons). This
+    translates libnx touch screen state into <linux/input.h>-like multi-touch protocol B events,
+    reports orientation changes from the accelerometer as EV_MSC/MSC_GYRO events (so KOReader's
+    auto-rotation works), and applet state as EV_SDL events. `ffi/input_switch.lua` hands them
+    to the frontend.
+
+    NOTE on the accelerometer: only the Switch Lite has a built-in one. On a regular Switch/OLED
+    the sensor lives in the Joy-Con, so gyro rotation there needs the Joy-Con attached (handheld
+    mode); docked, and undocked-without-Joy-Con, there is no sensor and we simply emit no gyro
+    events (KOReader stays on the manually chosen rotation).
+*/
+
+#include <switch.h>
+
+#include <math.h>
+#include <string.h>
+#include <time.h>
+
+#include "koswitch.h"
+
+#define MAX_SLOTS        10
+/* Size of HID's touch screen history (c.f., `hidGetTouchScreenStates`). */
+#define TOUCH_HISTORY 17
+/* At most, a sample adds or updates every slot (4 events each), plus SYN_REPORT. */
+#define MAX_SAMPLE_EVENTS (MAX_SLOTS * 4 + 1)
+
+/* Poll faster while the screen is being touched (and for a moment after), to spare the battery otherwise. */
+#define POLL_ACTIVE_NS   8000000ULL  /* ~120 Hz */
+#define POLL_IDLE_NS     16666667ULL /* ~60 Hz */
+#define ACTIVE_LINGER_NS 1000000000ULL
+
+/* Accelerometer: only look every so often, and require the new orientation to hold before committing to it. */
+#define GYRO_SAMPLE_NS   200000000ULL /* 5 Hz is plenty for orientation */
+#define GYRO_SETTLE_NS   500000000ULL
+/*
+    Rotation the device points to (mod 4) is added to the geometric quadrant. If, on real hardware,
+    the screen rotates the wrong way (e.g. by 90° or 180°), change this: 0..3 cycle through the mappings.
+*/
+#define GYRO_BASE 0
+
+typedef struct {
+    bool active;
+    u32 finger_id;
+    u32 x;
+    u32 y;
+} touch_slot;
+
+typedef struct {
+    ko_input_event *events;
+    int count;
+    int max;
+    struct timespec ts;
+} event_queue;
+
+static bool g_ready;
+static bool g_quit_sent;
+static u64 g_touch_sampling_number;
+static bool g_touch_synced;
+static u64 g_last_touch_ns;
+static int g_operation_mode = -1;
+static touch_slot g_slots[MAX_SLOTS];
+
+static HidSixAxisSensorHandle g_sixaxis;
+static bool g_gyro_ready;
+static int g_gyro_rotation = -1;      /* last reported KO_ROTATED_* */
+static int g_gyro_pending = -1;       /* candidate awaiting the settle time */
+static u64 g_gyro_pending_since;
+static u64 g_gyro_next_sample;
+
+static u64 timespec_to_ns(const struct timespec *ts)
+{
+    return (u64)ts->tv_sec * 1000000000ULL + (u64)ts->tv_nsec;
+}
+
+static void emit(event_queue *q, int type, int code, int value)
+{
+    if (q->count >= q->max)
+        return;
+    ko_input_event *ev = &q->events[q->count++];
+    ev->type = type;
+    ev->code = code;
+    ev->value = value;
+    ev->reserved = 0;
+    ev->sec = q->ts.tv_sec;
+    ev->usec = q->ts.tv_nsec / 1000;
+}
+
+int ko_input_init(void)
+{
+    if (g_ready)
+        return 0;
+    hidInitializeTouchScreen();
+    /* The accelerometer is read through the handheld Npad's six-axis sensor. */
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    if (R_SUCCEEDED(hidGetSixAxisSensorHandles(&g_sixaxis, 1, HidNpadIdType_Handheld, HidNpadStyleTag_NpadHandheld))
+            && R_SUCCEEDED(hidStartSixAxisSensor(g_sixaxis)))
+        g_gyro_ready = true;
+    g_ready = true;
+    return 0;
+}
+
+static bool any_slot_active(void)
+{
+    for (int s = 0; s < MAX_SLOTS; s++) {
+        if (g_slots[s].active)
+            return true;
+    }
+    return false;
+}
+
+/* Map the in-plane gravity vector to a KO_ROTATED_* value, or -1 when the console lies too flat to tell. */
+static int accel_to_rotation(float ax, float ay)
+{
+    /* Need a clear tilt (~0.4g in-plane) so a flat console doesn't flip orientation randomly. */
+    if (ax * ax + ay * ay < 0.16f)
+        return -1;
+    /* Quadrant of gravity around the screen, quantized to 0/90/180/270 (M_PI may be absent in newlib). */
+    static const float HALF_PI = 1.57079632679489661923f;
+    float angle = atan2f(ax, -ay);
+    int quadrant = (int)lroundf(angle / HALF_PI);
+    return ((quadrant + GYRO_BASE) % 4 + 4) % 4;
+}
+
+static void poll_gyro(event_queue *q, u64 now)
+{
+    if (!g_gyro_ready || now < g_gyro_next_sample)
+        return;
+    g_gyro_next_sample = now + GYRO_SAMPLE_NS;
+
+    HidSixAxisSensorState state;
+    if (hidGetSixAxisSensorStates(g_sixaxis, &state, 1) == 0 ||
+        !(state.attributes & HidSixAxisSensorAttribute_IsConnected))
+        return;
+
+    int rotation = accel_to_rotation(state.acceleration.x, state.acceleration.y);
+    if (rotation < 0)
+        return;
+    if (rotation != g_gyro_pending) {
+        /* New candidate: wait for it to settle before committing, to ignore brief wobbles. */
+        g_gyro_pending = rotation;
+        g_gyro_pending_since = now;
+        return;
+    }
+    if (rotation != g_gyro_rotation && now - g_gyro_pending_since >= GYRO_SETTLE_NS) {
+        g_gyro_rotation = rotation;
+        emit(q, KO_EV_MSC, KO_MSC_GYRO, rotation);
+    }
+}
+
+/* Turns one touch screen sample into events. Returns true if anything changed. */
+static bool process_touch_sample(event_queue *q, const HidTouchScreenState *state)
+{
+    bool seen[MAX_SLOTS] = { false };
+    bool dirty = false;
+    int count = state->count < 0 ? 0 : state->count > 16 ? 16 : state->count;
+    for (int i = 0; i < count; i++) {
+        const HidTouchState *t = &state->touches[i];
+        u32 x = t->x < KO_FB_WIDTH ? t->x : KO_FB_WIDTH - 1;
+        u32 y = t->y < KO_FB_HEIGHT ? t->y : KO_FB_HEIGHT - 1;
+        int slot = -1;
+        for (int s = 0; s < MAX_SLOTS; s++) {
+            if (g_slots[s].active && g_slots[s].finger_id == t->finger_id) {
+                slot = s;
+                break;
+            }
+        }
+        if (slot < 0) {
+            /* New contact. */
+            for (int s = 0; s < MAX_SLOTS; s++) {
+                if (!g_slots[s].active && !seen[s]) {
+                    slot = s;
+                    break;
+                }
+            }
+            if (slot < 0)
+                continue;
+            g_slots[slot] = (touch_slot){ true, t->finger_id, x, y };
+            emit(q, KO_EV_ABS, KO_ABS_MT_SLOT, slot);
+            emit(q, KO_EV_ABS, KO_ABS_MT_TRACKING_ID, slot);
+            emit(q, KO_EV_ABS, KO_ABS_MT_POSITION_X, x);
+            emit(q, KO_EV_ABS, KO_ABS_MT_POSITION_Y, y);
+            dirty = true;
+        } else if (g_slots[slot].x != x || g_slots[slot].y != y) {
+            /* Motion. */
+            g_slots[slot].x = x;
+            g_slots[slot].y = y;
+            emit(q, KO_EV_ABS, KO_ABS_MT_SLOT, slot);
+            emit(q, KO_EV_ABS, KO_ABS_MT_POSITION_X, x);
+            emit(q, KO_EV_ABS, KO_ABS_MT_POSITION_Y, y);
+            dirty = true;
+        }
+        seen[slot] = true;
+    }
+    for (int s = 0; s < MAX_SLOTS; s++) {
+        if (g_slots[s].active && !seen[s]) {
+            /* Lift. */
+            g_slots[s].active = false;
+            emit(q, KO_EV_ABS, KO_ABS_MT_SLOT, s);
+            emit(q, KO_EV_ABS, KO_ABS_MT_TRACKING_ID, -1);
+            dirty = true;
+        }
+    }
+    if (dirty)
+        emit(q, KO_EV_SYN, KO_SYN_REPORT, 0);
+    return dirty;
+}
+
+static void poll_touch(event_queue *q, u64 now)
+{
+    HidTouchScreenState states[TOUCH_HISTORY];
+    size_t total = hidGetTouchScreenStates(states, TOUCH_HISTORY);
+    if (total == 0)
+        return;
+    /*
+        `states[0]` is the latest sample: replay the ones not seen yet, oldest first, so quick
+        taps and swipe paths aren't lost between two polls. If the sampling numbers went back
+        (e.g. HID was reset), resynchronize on the latest sample.
+    */
+    size_t unseen = 1;
+    if (g_touch_synced && states[0].sampling_number >= g_touch_sampling_number) {
+        unseen = 0;
+        while (unseen < total && states[unseen].sampling_number > g_touch_sampling_number)
+            unseen++;
+    }
+    for (size_t i = unseen; i-- > 0;) {
+        /* Keep whole samples together: the rest is picked up by the next poll. */
+        if (q->count > 0 && q->max - q->count < MAX_SAMPLE_EVENTS)
+            break;
+        if (process_touch_sample(q, &states[i]))
+            g_last_touch_ns = now;
+        g_touch_sampling_number = states[i].sampling_number;
+        g_touch_synced = true;
+    }
+}
+
+int ko_input_poll(ko_input_event *events, int max_events, int timeout_ms)
+{
+    ko_input_init();
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const u64 start = timespec_to_ns(&ts);
+    for (;;) {
+        event_queue q = { .events = events, .count = 0, .max = max_events };
+        clock_gettime(CLOCK_MONOTONIC, &q.ts);
+        const u64 now = timespec_to_ns(&q.ts);
+
+        /* Also services applet messages (focus, HOME menu, exit requests…). */
+        if (!appletMainLoop() && !g_quit_sent) {
+            g_quit_sent = true;
+            emit(&q, KO_EV_SDL, KO_SDL_QUIT, 1);
+            return q.count;
+        }
+
+        int mode = appletGetOperationMode();
+        if (mode != g_operation_mode) {
+            if (g_operation_mode >= 0)
+                emit(&q, KO_EV_SDL, KO_SDL_OPERATION_MODE, mode);
+            g_operation_mode = mode;
+        }
+
+        poll_touch(&q, now);
+        poll_gyro(&q, now);
+        if (q.count > 0)
+            return q.count;
+
+        if (timeout_ms == 0)
+            return 0;
+        u64 interval = any_slot_active() || now - g_last_touch_ns < ACTIVE_LINGER_NS ? POLL_ACTIVE_NS : POLL_IDLE_NS;
+        if (timeout_ms > 0) {
+            const u64 timeout = (u64)timeout_ms * 1000000ULL;
+            const u64 elapsed = now - start;
+            if (elapsed >= timeout)
+                return 0;
+            if (timeout - elapsed < interval)
+                interval = timeout - elapsed;
+        }
+        svcSleepThread(interval);
+    }
+}
diff --git a/switch/install.c b/switch/install.c
new file mode 100644
index 00000000..d00aa9b1
--- /dev/null
+++ b/switch/install.c
@@ -0,0 +1,292 @@
+/*
+    KOReader for Nintendo Switch: installation of the KOReader tree (c.f., `install.h`).
+*/
+
+#include "install.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* A hash of the tree, generated when packaging (the version alone doesn't change with every build). */
+#define VERSION_MARKER   ".install-id"
+#define REINSTALL_MARKER ".reinstall"
+#define MANIFEST         ".install-manifest"
+#define MANIFEST_TMP     ".install-manifest.tmp"
+#define PATH_SIZE        1024
+#define COPY_BUFFER_SIZE (512 * 1024)
+
+typedef struct {
+    char **items;
+    size_t count;
+    size_t capacity;
+} path_list;
+
+static bool list_add(path_list *list, const char *path)
+{
+    if (list->count == list->capacity) {
+        size_t capacity = list->capacity ? list->capacity * 2 : 1024;
+        char **items = realloc(list->items, capacity * sizeof(*items));
+        if (!items)
+            return false;
+        list->items = items;
+        list->capacity = capacity;
+    }
+    char *copy = strdup(path);
+    if (!copy)
+        return false;
+    list->items[list->count++] = copy;
+    return true;
+}
+
+static void list_free(path_list *list)
+{
+    for (size_t i = 0; i < list->count; i++)
+        free(list->items[i]);
+    free(list->items);
+    *list = (path_list){ 0 };
+}
+
+static int compare_paths(const void *a, const void *b)
+{
+    return strcmp(*(const char *const *)a, *(const char *const *)b);
+}
+
+/* NOTE: the list must be sorted. */
+static bool list_contains(const path_list *list, const char *path)
+{
+    return list->count && bsearch(&path, list->items, list->count, sizeof(*list->items), compare_paths);
+}
+
+static bool join(char *out, const char *root, const char *rel)
+{
+    int n = snprintf(out, PATH_SIZE, "%s/%s", root, rel);
+    return n > 0 && n < PATH_SIZE;
+}
+
+static bool is_directory(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static bool read_first_line(const char *path, char *buf, size_t size)
+{
+    FILE *fp = fopen(path, "r");
+    if (!fp)
+        return false;
+    bool ok = fgets(buf, (int)size, fp) != NULL;
+    fclose(fp);
+    if (ok)
+        buf[strcspn(buf, "\r\n")] = '\0';
+    return ok;
+}
+
+/* Lists the files under `root` (as paths relative to it). */
+static bool collect_files(const char *root, const char *rel, path_list *list)
+{
+    char dir[PATH_SIZE];
+    int n = rel[0] ? snprintf(dir, sizeof(dir), "%s/%s", root, rel) : snprintf(dir, sizeof(dir), "%s", root);
+    if (n <= 0 || n >= (int)sizeof(dir))
+        return false;
+    DIR *d = opendir(dir);
+    if (!d)
+        return false;
+    bool ok = true;
+    struct dirent *e;
+    while (ok && (e = readdir(d))) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+            continue;
+        char child_rel[PATH_SIZE], child[PATH_SIZE];
+        n = rel[0] ? snprintf(child_rel, sizeof(child_rel), "%s/%s", rel, e->d_name)
+                   : snprintf(child_rel, sizeof(child_rel), "%s", e->d_name);
+        if (n <= 0 || n >= (int)sizeof(child_rel) || !join(child, root, child_rel))
+            ok = false;
+        else if (is_directory(child))
+            ok = collect_files(root, child_rel, list);
+        else
+            ok = list_add(list, child_rel);
+    }
+    closedir(d);
+    return ok;
+}
+
+/* Creates the missing parent directories of `rel`, below `root`. */
+static bool make_parents(const char *root, const char *rel)
+{
+    char path[PATH_SIZE];
+    if (!join(path, root, rel))
+        return false;
+    for (char *p = path + strlen(root) + 1; (p = strchr(p, '/')); p++) {
+        *p = '\0';
+        bool ok = mkdir(path, 0777) == 0 || errno == EEXIST || is_directory(path);
+        *p = '/';
+        if (!ok)
+            return false;
+    }
+    return true;
+}
+
+static bool copy_file(const char *src, const char *dst, char *buffer)
+{
+    FILE *in = fopen(src, "rb");
+    if (!in)
+        return false;
+    FILE *out = fopen(dst, "wb");
+    if (!out) {
+        fclose(in);
+        return false;
+    }
+    bool ok = true;
+    size_t n;
+    while ((n = fread(buffer, 1, COPY_BUFFER_SIZE, in)) > 0) {
+        if (fwrite(buffer, 1, n, out) != n) {
+            ok = false;
+            break;
+        }
+    }
+    if (ferror(in))
+        ok = false;
+    fclose(in);
+    if (fclose(out) != 0)
+        ok = false;
+    return ok;
+}
+
+/* Manifest entries are only ever deleted if they're plain relative paths below the installation. */
+static bool is_safe_relative_path(const char *rel)
+{
+    if (!rel[0] || rel[0] == '/' || strchr(rel, '\\') || strchr(rel, ':'))
+        return false;
+    for (const char *p = rel; *p;) {
+        size_t n = strcspn(p, "/");
+        if (n == 0 || (n == 1 && p[0] == '.') || (n == 2 && p[0] == '.' && p[1] == '.'))
+            return false;
+        p += n;
+        if (*p == '/')
+            p++;
+    }
+    return true;
+}
+
+static void read_manifest(const char *dst, path_list *list)
+{
+    char path[PATH_SIZE], line[PATH_SIZE];
+    if (!join(path, dst, MANIFEST))
+        return;
+    FILE *fp = fopen(path, "r");
+    if (!fp)
+        return;
+    while (fgets(line, sizeof(line), fp)) {
+        line[strcspn(line, "\r\n")] = '\0';
+        if (line[0] && !list_add(list, line))
+            break;
+    }
+    fclose(fp);
+}
+
+/* Best effort: without a manifest, the next update just can't clean up after this one. */
+static void write_manifest(const char *dst, const path_list *files)
+{
+    char tmp[PATH_SIZE], path[PATH_SIZE];
+    if (!join(tmp, dst, MANIFEST_TMP) || !join(path, dst, MANIFEST))
+        return;
+    FILE *fp = fopen(tmp, "w");
+    if (!fp)
+        return;
+    bool ok = true;
+    for (size_t i = 0; ok && i < files->count; i++)
+        ok = fputs(files->items[i], fp) >= 0 && fputc('\n', fp) != EOF;
+    if (fclose(fp) != 0 || !ok) {
+        unlink(tmp);
+        return;
+    }
+    /* NOTE: renaming over an existing file fails on some filesystems. */
+    if (rename(tmp, path) != 0 && (unlink(path), rename(tmp, path) != 0))
+        unlink(tmp);
+}
+
+/* Removes the directories left empty by the removal of `rel`, up to (excluding) `root`. */
+static void remove_empty_parents(const char *root, const char *rel)
+{
+    char path[PATH_SIZE];
+    if (!join(path, root, rel))
+        return;
+    const size_t root_len = strlen(root);
+    for (char *slash = strrchr(path, '/'); slash && (size_t)(slash - path) > root_len; slash = strrchr(path, '/')) {
+        *slash = '\0';
+        if (rmdir(path) != 0)
+            break;
+    }
+}
+
+bool ko_install_needed(const char *src, const char *dst)
+{
+    char path[PATH_SIZE], embedded[128], installed[128];
+    if (!join(path, src, VERSION_MARKER) || !read_first_line(path, embedded, sizeof(embedded)))
+        return false;
+    if (join(path, dst, REINSTALL_MARKER) && access(path, F_OK) == 0) {
+        unlink(path);
+        return true;
+    }
+    if (!join(path, dst, VERSION_MARKER) || !read_first_line(path, installed, sizeof(installed)))
+        return true;
+    return strcmp(embedded, installed) != 0;
+}
+
+bool ko_install(const char *src, const char *dst, ko_install_progress progress, void *userdata)
+{
+    bool ok = false;
+    path_list files = { 0 }, previous = { 0 };
+    char s[PATH_SIZE], d[PATH_SIZE];
+    char *buffer = malloc(COPY_BUFFER_SIZE);
+    if (!buffer)
+        goto out;
+    if (mkdir(dst, 0777) != 0 && errno != EEXIST && !is_directory(dst))
+        goto out;
+    if (!collect_files(src, "", &files))
+        goto out;
+    qsort(files.items, files.count, sizeof(*files.items), compare_paths);
+    if (!list_contains(&files, VERSION_MARKER))
+        goto out;
+
+    /* Until the version marker is written back, an interrupted install is resumed on the next launch. */
+    if (!join(d, dst, VERSION_MARKER) || (unlink(d) != 0 && errno != ENOENT))
+        goto out;
+
+    const unsigned total = (unsigned)files.count - 1;
+    unsigned done = 0;
+    for (size_t i = 0; i < files.count; i++) {
+        const char *rel = files.items[i];
+        if (!strcmp(rel, VERSION_MARKER))
+            continue;
+        if (!join(s, src, rel) || !join(d, dst, rel) || !make_parents(dst, rel) || !copy_file(s, d, buffer))
+            goto out;
+        if (progress)
+            progress(++done, total, userdata);
+    }
+
+    /* Remove what the previous version installed, and this one doesn't have anymore. */
+    read_manifest(dst, &previous);
+    for (size_t i = 0; i < previous.count; i++) {
+        const char *rel = previous.items[i];
+        struct stat st;
+        if (!is_safe_relative_path(rel) || list_contains(&files, rel) || !join(d, dst, rel) ||
+            stat(d, &st) != 0 || !S_ISREG(st.st_mode))
+            continue;
+        if (unlink(d) == 0)
+            remove_empty_parents(dst, rel);
+    }
+    write_manifest(dst, &files);
+
+    ok = join(s, src, VERSION_MARKER) && join(d, dst, VERSION_MARKER) && copy_file(s, d, buffer);
+out:
+    list_free(&files);
+    list_free(&previous);
+    free(buffer);
+    return ok;
+}
diff --git a/switch/install.h b/switch/install.h
new file mode 100644
index 00000000..a8a507ce
--- /dev/null
+++ b/switch/install.h
@@ -0,0 +1,30 @@
+/*
+    KOReader for Nintendo Switch: installation of the KOReader tree.
+
+    The tree is embedded in the RomFS, and copied to the SD card on first launch, and
+    whenever the embedded version differs from the installed one. Files installed by a
+    previous version that are gone from the new one are then removed, going by the list
+    of installed files kept alongside (`.install-manifest`): files added by the user
+    (settings, fonts, dictionaries, plugins…) are never touched.
+
+    NOTE: plain POSIX, so it can be tested on the host (c.f., `install_test.c`).
+*/
+
+#ifndef KOREADER_SWITCH_INSTALL_H
+#define KOREADER_SWITCH_INSTALL_H
+
+#include <stdbool.h>
+
+typedef void (*ko_install_progress)(unsigned done, unsigned total, void *userdata);
+
+/*
+    Whether `dst` needs a (re)install from `src`: its version marker is missing or different,
+    or a reinstall was requested (with an empty `.reinstall` file, which is consumed).
+    Always false if `src` has no version marker.
+*/
+bool ko_install_needed(const char *src, const char *dst);
+
+/* Installs the tree at `src` over `dst`. The version marker is written last, so an interrupted install is resumed. */
+bool ko_install(const char *src, const char *dst, ko_install_progress progress, void *userdata);
+
+#endif
diff --git a/switch/install_test.c b/switch/install_test.c
new file mode 100644
index 00000000..32f5ca46
--- /dev/null
+++ b/switch/install_test.c
@@ -0,0 +1,176 @@
+/*
+    Host test for `install.c` (not part of the build):
+        cc -std=gnu11 -Wall -Wextra -o install_test install.c install_test.c && ./install_test /tmp/somewhere
+*/
+
+#include "install.h"
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int failures;
+
+#define CHECK(cond)                                                             \
+    do {                                                                        \
+        if (!(cond)) {                                                          \
+            fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);     \
+            failures++;                                                         \
+        }                                                                       \
+    } while (0)
+
+static void make_path(char *out, const char *root, const char *rel)
+{
+    snprintf(out, PATH_MAX, "%s/%s", root, rel);
+}
+
+static void write_file(const char *root, const char *rel, const char *content)
+{
+    char path[PATH_MAX];
+    make_path(path, root, rel);
+    mkdir(root, 0777);
+    for (char *p = path + strlen(root) + 1; (p = strchr(p, '/')); p++) {
+        *p = '\0';
+        mkdir(path, 0777);
+        *p = '/';
+    }
+    FILE *fp = fopen(path, "w");
+    if (!fp) {
+        perror(path);
+        exit(2);
+    }
+    fputs(content, fp);
+    fclose(fp);
+}
+
+static bool exists(const char *root, const char *rel)
+{
+    char path[PATH_MAX];
+    struct stat st;
+    make_path(path, root, rel);
+    return stat(path, &st) == 0;
+}
+
+static bool has_content(const char *root, const char *rel, const char *expected)
+{
+    char path[PATH_MAX], buf[4096] = "";
+    make_path(path, root, rel);
+    FILE *fp = fopen(path, "r");
+    if (!fp)
+        return false;
+    size_t n = fread(buf, 1, sizeof(buf) - 1, fp);
+    buf[n] = '\0';
+    fclose(fp);
+    return strcmp(buf, expected) == 0;
+}
+
+static unsigned progress_calls, progress_done, progress_total;
+
+static void on_progress(unsigned done, unsigned total, void *userdata)
+{
+    CHECK(userdata == &progress_calls);
+    progress_calls++;
+    progress_done = done;
+    progress_total = total;
+}
+
+int main(int argc, char *argv[])
+{
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s EMPTY_DIRECTORY\n", argv[0]);
+        return 2;
+    }
+    const char *base = argv[1];
+    char src[PATH_MAX], dst[PATH_MAX], fresh[PATH_MAX], empty[PATH_MAX], path[PATH_MAX];
+    make_path(src, base, "romfs");
+    make_path(dst, base, "sdcard");
+    make_path(fresh, base, "fresh");
+    make_path(empty, base, "empty");
+    mkdir(empty, 0777);
+
+    /* Embedded tree, identified by `.install-id`: one plugin of the previous build is gone. */
+    write_file(src, ".install-id", "tree2\n");
+    write_file(src, "git-rev", "v2\n");
+    write_file(src, "reader.lua", "reader v2");
+    write_file(src, "plugins/kept.koplugin/main.lua", "kept v2");
+
+    /* Installed tree (same version, previous build), with files added by the user, and a tampered manifest. */
+    write_file(dst, ".install-id", "tree1\n");
+    write_file(dst, "git-rev", "v2\n");
+    write_file(dst, "reader.lua", "reader v1");
+    write_file(dst, "plugins/gone.koplugin/main.lua", "gone");
+    write_file(dst, "plugins/gone.koplugin/sub/extra.lua", "gone too");
+    write_file(dst, "plugins/kept.koplugin/main.lua", "kept v1");
+    write_file(dst, "plugins/user.koplugin/main.lua", "user plugin");
+    write_file(dst, "settings.reader.lua", "user settings");
+    write_file(dst, ".install-manifest",
+               ".install-id\ngit-rev\nreader.lua\n"
+               "plugins/gone.koplugin/main.lua\nplugins/gone.koplugin/sub/extra.lua\n"
+               "plugins/kept.koplugin/main.lua\n"
+               "../outside.txt\n/etc/hosts\nplugins/../settings.reader.lua\n./settings.reader.lua\n"
+               "plugins//user.koplugin/main.lua\nplugins\n\n");
+    write_file(base, "outside.txt", "outside");
+
+    /* Update. */
+    CHECK(ko_install_needed(src, dst));
+    CHECK(ko_install(src, dst, on_progress, &progress_calls));
+    CHECK(!ko_install_needed(src, dst));
+    CHECK(has_content(dst, ".install-id", "tree2\n"));
+    CHECK(has_content(dst, "git-rev", "v2\n"));
+    CHECK(has_content(dst, "reader.lua", "reader v2"));
+    CHECK(has_content(dst, "plugins/kept.koplugin/main.lua", "kept v2"));
+    CHECK(progress_calls == 3 && progress_done == 3 && progress_total == 3);
+    /* Obsolete files are removed, along with the directories they leave empty. */
+    CHECK(!exists(dst, "plugins/gone.koplugin/main.lua"));
+    CHECK(!exists(dst, "plugins/gone.koplugin/sub/extra.lua"));
+    CHECK(!exists(dst, "plugins/gone.koplugin"));
+    CHECK(exists(dst, "plugins/kept.koplugin"));
+    /* The user's files, and anything outside the installation, are left alone. */
+    CHECK(has_content(dst, "plugins/user.koplugin/main.lua", "user plugin"));
+    CHECK(has_content(dst, "settings.reader.lua", "user settings"));
+    CHECK(has_content(base, "outside.txt", "outside"));
+    CHECK(exists(dst, "plugins"));
+    /* The manifest now lists this build's files. */
+    CHECK(has_content(dst, ".install-manifest", ".install-id\ngit-rev\nplugins/kept.koplugin/main.lua\nreader.lua\n"));
+    CHECK(!exists(dst, ".install-manifest.tmp"));
+
+    /* Requested reinstall: the marker is consumed. */
+    write_file(dst, ".reinstall", "");
+    CHECK(ko_install_needed(src, dst));
+    CHECK(!exists(dst, ".reinstall"));
+    CHECK(!ko_install_needed(src, dst));
+
+    /* Installation made by a build without `.install-id`: reinstalled. */
+    make_path(path, dst, ".install-id");
+    unlink(path);
+    CHECK(ko_install_needed(src, dst));
+
+    /* Fresh install, into a directory that doesn't exist yet, without progress callback. */
+    CHECK(ko_install_needed(src, fresh));
+    CHECK(ko_install(src, fresh, NULL, NULL));
+    CHECK(has_content(fresh, "plugins/kept.koplugin/main.lua", "kept v2"));
+    CHECK(has_content(fresh, ".install-id", "tree2\n"));
+    CHECK(!ko_install_needed(src, fresh));
+
+    /* Interrupted install (no marker): needed again, and resumed. */
+    make_path(path, fresh, ".install-id");
+    unlink(path);
+    CHECK(ko_install_needed(src, fresh));
+    CHECK(ko_install(src, fresh, NULL, NULL));
+    CHECK(!ko_install_needed(src, fresh));
+
+    /* A tree without marker is never installed. */
+    CHECK(!ko_install_needed(empty, fresh));
+    CHECK(!ko_install(empty, fresh, NULL, NULL));
+    CHECK(has_content(fresh, ".install-id", "tree2\n"));
+
+    /* A missing source fails cleanly. */
+    make_path(path, base, "missing");
+    CHECK(!ko_install(path, fresh, NULL, NULL));
+
+    printf(failures ? "install_test: %d failure(s)\n" : "install_test: all checks passed\n", failures);
+    return failures != 0;
+}
diff --git a/switch/koswitch.h b/switch/koswitch.h
new file mode 100644
index 00000000..fa87350b
--- /dev/null
+++ b/switch/koswitch.h
@@ -0,0 +1,73 @@
+/*
+    KOReader for Nintendo Switch (libnx homebrew): native glue.
+
+    Everything declared here is also exposed to Lua through `ffi/switch_h.lua`
+    (keep both in sync), and resolved via the link time symbol table.
+*/
+
+#ifndef KOREADER_SWITCH_H
+#define KOREADER_SWITCH_H
+
+#include <stdint.h>
+
+#define KO_FB_WIDTH  1280
+#define KO_FB_HEIGHT 720
+
+/* Input event types & codes, matching <linux/input.h> (and KOReader's EV_SDL). Touch screen + accelerometer. */
+#define KO_EV_SYN 0
+#define KO_EV_ABS 3
+#define KO_EV_MSC 4
+#define KO_EV_SDL 83
+
+#define KO_SYN_REPORT         0
+#define KO_ABS_MT_SLOT        47
+#define KO_ABS_MT_POSITION_X  53
+#define KO_ABS_MT_POSITION_Y  54
+#define KO_ABS_MT_TRACKING_ID 57
+
+/* Accelerometer rotation events: EV_MSC / MSC_GYRO, value = KO_ROTATED_* (c.f., KOReader's handleMiscGyroEv). */
+#define KO_MSC_GYRO 71
+#define KO_ROTATED_UPRIGHT           0
+#define KO_ROTATED_CLOCKWISE         1
+#define KO_ROTATED_UPSIDE_DOWN       2
+#define KO_ROTATED_COUNTER_CLOCKWISE 3
+
+/* EV_SDL codes. */
+#define KO_SDL_QUIT           1 /* value: unused */
+#define KO_SDL_OPERATION_MODE 2 /* value: 0 = handheld, 1 = docked */
+#define KO_SDL_CHARGING       3 /* value: 0 = unplugged, 1 = charging */
+
+typedef struct ko_input_event {
+    int32_t type;
+    int32_t code;
+    int32_t value;
+    int32_t reserved;
+    int64_t sec;
+    int64_t usec;
+} ko_input_event;
+
+/* Framebuffer (1280x720 RGBA8888, landscape: the panel's native orientation). */
+int  ko_fb_init(void);
+void ko_fb_close(void);
+void ko_fb_present(const uint8_t *pixels, int stride, int invert);
+
+/* Input. */
+int  ko_input_init(void);
+/*
+    Returns the number of events stored in `events` (0 on timeout); a negative timeout blocks.
+    NOTE: `max_events` should be at least 41, so a single touch screen sample always fits.
+*/
+int  ko_input_poll(ko_input_event *events, int max_events, int timeout_ms);
+
+/* Device. */
+int   ko_get_product_model(void);
+int   ko_is_applet_mode(void);
+int   ko_get_operation_mode(void);
+int   ko_get_battery_percentage(void);
+int   ko_is_charging(void);
+float ko_get_brightness(void);
+int   ko_set_brightness(float value);
+int   ko_is_network_connected(void);
+void  ko_set_auto_sleep_inhibited(int inhibited);
+
+#endif
diff --git a/switch/main.c b/switch/main.c
new file mode 100644
index 00000000..83f2ecc3
--- /dev/null
+++ b/switch/main.c
@@ -0,0 +1,451 @@
+/*
+    KOReader for Nintendo Switch: application entry point.
+
+    - installs the KOReader tree embedded in the RomFS to the SD card, on first
+      launch or after an update (c.f., `install.c`);
+    - shows a splash screen asking to turn the console sideways: the UI is laid
+      out in portrait, like on an e-reader (turned clockwise, power button on
+      the right);
+    - sets up the environment (logging, time zone, services);
+    - runs `reader.lua` with LuaJIT, on a thread with a comfortable stack.
+
+    Everything is operated with the touch screen, Joy-Con aren't needed: that's
+    also why exiting closes the application instead of going back to the
+    Homebrew Menu, which can only be closed with the + button.
+*/
+
+#include <switch.h>
+
+#include <ctype.h>
+#include <pthread.h>
+#include <setjmp.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <lauxlib.h>
+#include <lua.h>
+#include <lualib.h>
+
+#include "install.h"
+#include "koswitch.h"
+
+#define KO_HOME           "sdmc:/switch/koreader"
+#define KO_ROMFS          "romfs:/koreader"
+#define KO_LOG            "crash.log"
+#define KO_OLD_LOG        "crash.old.log"
+#define KO_LOG_MAX_SIZE   (1024 * 1024)
+#define KO_RESTART_CODE   85
+#define KO_PATH_SIZE      1024
+#define KO_LUA_STACK_SIZE (32 * 1024 * 1024)
+
+#define COLOR_TEXT   0x000000
+#define COLOR_ACCENT 0x505050
+
+/* libnx: 1 = close the application (or applet) on exit, instead of returning to the homebrew loader. */
+extern u32 __nx_applet_exit_mode;
+
+static char g_self_path[KO_PATH_SIZE];
+static uint8_t *g_screen;
+static bool g_restart;
+static int g_exit_status = EXIT_SUCCESS;
+/* `os.exit` unwinds back to `run_koreader` (c.f., `ko_os_exit`). */
+static jmp_buf g_exit_jmp;
+
+/* -- Static symbols ------------------------------------------------------------ */
+
+/* Generated at link time by `gen_symtab.py`. */
+typedef struct {
+    const char *name;
+    void *addr;
+} ko_symbol;
+
+extern const ko_symbol ko_symtab[];
+extern const size_t ko_symtab_size;
+
+static int ko_symbol_cmp(const void *key, const void *entry)
+{
+    return strcmp(key, ((const ko_symbol *)entry)->name);
+}
+
+/* Used by LuaJIT (`ffi.C`, `ffi.load`), c.f. `koreader-luajit-switch.patch`. */
+void *lj_clib_static_lookup(const char *name)
+{
+    const ko_symbol *s = bsearch(name, ko_symtab, ko_symtab_size, sizeof(*ko_symtab), ko_symbol_cmp);
+    return s ? s->addr : NULL;
+}
+
+/* -- Launcher UI ---------------------------------------------------------------- */
+
+static void put_pixel(int x, int y, uint32_t rgb)
+{
+    if ((unsigned)x >= KO_FB_WIDTH || (unsigned)y >= KO_FB_HEIGHT)
+        return;
+    uint8_t *p = g_screen + ((size_t)y * KO_FB_WIDTH + (size_t)x) * 4;
+    p[0] = rgb >> 16;
+    p[1] = rgb >> 8;
+    p[2] = rgb;
+    p[3] = 0xff;
+}
+
+/*
+    Draw text with the libnx console font (16x16 glyphs, one u16 per row, MSB first).
+    In portrait mode, coordinates are in the rotated 720x1280 space: the top of the text
+    points towards the console's left edge, matching the rotation used by the frontend.
+*/
+static void draw_text(const char *text, int x, int y, int scale, bool portrait, uint32_t rgb)
+{
+    const ConsoleFont *font = &consoleGetDefault()->font;
+    const uint16_t *gfx = font->gfx;
+    for (int n = 0; text[n]; n++) {
+        unsigned c = (unsigned char)text[n];
+        if (c < font->asciiOffset || c >= (unsigned)font->asciiOffset + font->numChars)
+            c = '?';
+        const uint16_t *glyph = gfx + 16 * (c - font->asciiOffset);
+        for (int row = 0; row < 16; row++) {
+            for (int col = 0; col < 16; col++) {
+                if (!(glyph[row] & (0x8000 >> col)))
+                    continue;
+                for (int dy = 0; dy < scale; dy++) {
+                    for (int dx = 0; dx < scale; dx++) {
+                        int ux = x + (n * 16 + col) * scale + dx;
+                        int uy = y + row * scale + dy;
+                        if (portrait)
+                            put_pixel(uy, KO_FB_HEIGHT - 1 - ux, rgb);
+                        else
+                            put_pixel(ux, uy, rgb);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void draw_text_centered(const char *text, int y, int scale, bool portrait, uint32_t rgb)
+{
+    int width = (int)strlen(text) * 16 * scale;
+    int screen_width = portrait ? KO_FB_HEIGHT : KO_FB_WIDTH;
+    draw_text(text, (screen_width - width) / 2, y, scale, portrait, rgb);
+}
+
+/* The splash is drawn in the panel's native landscape orientation, matching KOReader's default. */
+static void show_splash(const char *status)
+{
+    if (!g_screen)
+        return;
+    memset(g_screen, 0xff, (size_t)KO_FB_WIDTH * KO_FB_HEIGHT * 4);
+    draw_text_centered("KOReader", KO_FB_HEIGHT / 2 - 48, 4, false, COLOR_TEXT);
+    if (status)
+        draw_text_centered(status, KO_FB_HEIGHT / 2 + 40, 2, false, COLOR_ACCENT);
+    ko_fb_present(g_screen, KO_FB_WIDTH, 0);
+}
+
+/* Waits for a complete tap on the touch screen (ignoring a touch already in progress). */
+static void wait_for_tap(void)
+{
+    enum { WAIT_RELEASED, WAIT_TOUCH, WAIT_LIFT } phase = WAIT_RELEASED;
+    hidInitializeTouchScreen();
+    while (appletMainLoop()) {
+        HidTouchScreenState state = { 0 };
+        bool touching = hidGetTouchScreenStates(&state, 1) > 0 && state.count > 0;
+        if (phase == WAIT_RELEASED && !touching)
+            phase = WAIT_TOUCH;
+        else if (phase == WAIT_TOUCH && touching)
+            phase = WAIT_LIFT;
+        else if (phase == WAIT_LIFT && !touching)
+            break;
+        svcSleepThread(16000000ULL);
+    }
+}
+
+static void show_fatal_error(const char *message)
+{
+    fprintf(stderr, "KOReader: fatal error: %s\n", message);
+    if (!g_screen)
+        return;
+    memset(g_screen, 0xff, (size_t)KO_FB_WIDTH * KO_FB_HEIGHT * 4);
+    draw_text_centered("KOReader could not start", 48, 2, false, COLOR_TEXT);
+    /* Wrap the message to the screen width. */
+    char line[80];
+    const size_t cols = sizeof(line) - 1;
+    int y = 120;
+    for (const char *p = message; *p && y < KO_FB_HEIGHT - 80; y += 20) {
+        size_t n = strcspn(p, "\n");
+        if (n > cols)
+            n = cols;
+        memcpy(line, p, n);
+        line[n] = '\0';
+        /* The console font has no glyph for tabs (as found in Lua tracebacks). */
+        for (size_t i = 0; i < n; i++)
+            if (line[i] == '\t')
+                line[i] = ' ';
+        draw_text(line, 0, y, 1, false, COLOR_ACCENT);
+        p += n;
+        if (*p == '\n')
+            p++;
+    }
+    draw_text_centered("See /switch/koreader/crash.log - tap the screen to exit", KO_FB_HEIGHT - 48, 1, false, COLOR_TEXT);
+    ko_fb_present(g_screen, KO_FB_WIDTH, 0);
+    wait_for_tap();
+}
+
+static void on_install_progress(unsigned done, unsigned total, void *userdata)
+{
+    u64 *last_update = userdata;
+    u64 now = armTicksToNs(armGetSystemTick());
+    if (now - *last_update < 250000000ULL)
+        return;
+    *last_update = now;
+    char status[32];
+    snprintf(status, sizeof(status), "Installing: %u%%", total ? done * 100 / total : 0);
+    show_splash(status);
+}
+
+/* -- Environment ---------------------------------------------------------------- */
+
+/*
+    Without Joy-Con, the Homebrew Menu can't be closed (that needs the + button), so
+    leaving KOReader closes the application and goes straight back to the HOME menu.
+    Restarting goes through the homebrew loader instead (except when installed as a
+    title, c.f. `ko_os_exit`).
+*/
+static void set_exit_mode(void)
+{
+    __nx_applet_exit_mode = g_restart ? 0 : 1;
+}
+
+/* The log is appended to (so a crash can still be looked into after relaunching), and rotated when it gets big. */
+static void setup_logging(void)
+{
+    struct stat st;
+    if (stat(KO_LOG, &st) == 0 && st.st_size > KO_LOG_MAX_SIZE) {
+        unlink(KO_OLD_LOG);
+        rename(KO_LOG, KO_OLD_LOG);
+    }
+    if (!freopen(KO_LOG, "a", stdout))
+        return;
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    /* A file can't be opened twice for writing: stderr (unbuffered) shares stdout's descriptor instead. */
+    fflush(stderr);
+    dup2(fileno(stdout), STDERR_FILENO);
+    if (fileno(stdout) != STDOUT_FILENO)
+        dup2(fileno(stdout), STDOUT_FILENO);
+}
+
+static void setup_timezone(void)
+{
+    u64 now;
+    TimeCalendarTime caltime;
+    TimeCalendarAdditionalInfo info;
+    if (R_FAILED(timeGetCurrentTime(TimeType_UserSystemClock, &now)) ||
+        R_FAILED(timeToCalendarTimeWithMyRule(now, &caltime, &info)))
+        return;
+    char name[sizeof(info.timezoneName) + 1] = "UTC";
+    size_t len = strnlen(info.timezoneName, sizeof(info.timezoneName));
+    bool valid = len >= 3;
+    for (size_t i = 0; i < len; i++)
+        valid = valid && isalpha((unsigned char)info.timezoneName[i]);
+    if (valid) {
+        memcpy(name, info.timezoneName, len);
+        name[len] = '\0';
+    }
+    /* POSIX TZ offsets are positive west of Greenwich. */
+    int offset = info.offset;
+    int abs_offset = offset < 0 ? -offset : offset;
+    char tz[32];
+    snprintf(tz, sizeof(tz), "%s%c%d:%02d:%02d", name, offset > 0 ? '-' : '+',
+             abs_offset / 3600, abs_offset % 3600 / 60, abs_offset % 60);
+    setenv("TZ", tz, 1);
+    tzset();
+}
+
+/* -- Lua -------------------------------------------------------------------------- */
+
+static int ko_os_exit(lua_State *L)
+{
+    int status;
+    if (lua_isboolean(L, 1))
+        status = lua_toboolean(L, 1) ? EXIT_SUCCESS : EXIT_FAILURE;
+    else
+        status = (int)luaL_optinteger(L, 1, EXIT_SUCCESS);
+    bool close = lua_toboolean(L, 2);
+    if (status == KO_RESTART_CODE) {
+        if (envIsNso()) {
+            /* Installed as a title (NSP): the system relaunches us once we've exited. */
+            appletRestartProgram(NULL, 0);
+        } else if (g_self_path[0] && envHasNextLoad() && R_SUCCEEDED(envSetNextLoad(g_self_path, g_self_path))) {
+            /* Ask the homebrew loader to start us again. */
+            g_restart = true;
+        }
+        status = EXIT_SUCCESS;
+    }
+    g_exit_status = status;
+    /* Like LuaJIT's `os.exit`: close the state (running finalizers) if asked to. */
+    if (close)
+        lua_close(L);
+    fflush(NULL);
+    /*
+        Don't `exit` from this thread: libnx's exit path switches to the main thread's stack
+        to return to the loader, while the main thread is still waiting for us. Unwind back
+        to `run_koreader` instead, and let `main` return.
+    */
+    longjmp(g_exit_jmp, 1);
+}
+
+/* `require` for Lua C modules, mirroring the monolibtic loader in `ffi/loadlib.lua`. */
+static int ko_static_searcher(lua_State *L)
+{
+    static const char prefix[] = "libs/libkoreader-";
+    const char *name = luaL_checkstring(L, 1);
+    char symbol[256];
+    if (strncmp(name, prefix, sizeof(prefix) - 1) == 0) {
+        snprintf(symbol, sizeof(symbol), "luaopen_%s", name + sizeof(prefix) - 1);
+    } else {
+        snprintf(symbol, sizeof(symbol), "luaopen_%s", name);
+        for (char *c = symbol; *c; c++)
+            if (*c == '.')
+                *c = '_';
+    }
+    lua_CFunction fn = (lua_CFunction)lj_clib_static_lookup(symbol);
+    if (!fn) {
+        lua_pushfstring(L, "\n\tno static symbol '%s'", symbol);
+        return 1;
+    }
+    lua_pushcfunction(L, fn);
+    return 1;
+}
+
+static int ko_traceback(lua_State *L)
+{
+    const char *msg = lua_tostring(L, 1);
+    luaL_traceback(L, L, msg ? msg : "(error object is not a string)", 1);
+    return 1;
+}
+
+/* The JIT compiler is disabled (no executable memory for machine code). */
+static const char ko_prelude[] =
+    "jit.opt = jit.opt or { start = function() end }\n"
+    "jit.on = function() end\n";
+
+static void *run_koreader(void *arg)
+{
+    (void)arg;
+    lua_State *L = luaL_newstate();
+    if (!L) {
+        show_fatal_error("Could not create the Lua state (out of memory?).");
+        g_exit_status = EXIT_FAILURE;
+        return NULL;
+    }
+    luaL_openlibs(L);
+
+    lua_getglobal(L, "os");
+    lua_pushcfunction(L, ko_os_exit);
+    lua_setfield(L, -2, "exit");
+    lua_pop(L, 1);
+
+    lua_getglobal(L, "package");
+    lua_getfield(L, -1, "loaders");
+    lua_pushcfunction(L, ko_static_searcher);
+    lua_rawseti(L, -2, (int)lua_objlen(L, -2) + 1);
+    lua_pop(L, 2);
+
+    lua_newtable(L);
+    lua_pushliteral(L, "reader.lua");
+    lua_rawseti(L, -2, 0);
+    lua_setglobal(L, "arg");
+
+    lua_pushcfunction(L, ko_traceback);
+    if (setjmp(g_exit_jmp) == 0) {
+        if (luaL_loadbuffer(L, ko_prelude, sizeof(ko_prelude) - 1, "=prelude") ||
+            lua_pcall(L, 0, 0, -2) ||
+            luaL_loadfile(L, "reader.lua") ||
+            lua_pcall(L, 0, 0, -2)) {
+            const char *msg = lua_tostring(L, -1);
+            show_fatal_error(msg ? msg : "unknown error");
+            g_exit_status = EXIT_FAILURE;
+        }
+        lua_close(L);
+    }
+    /* Otherwise, `os.exit` was called: the state was closed if requested, or left as is (like LuaJIT does). */
+    return NULL;
+}
+
+int main(int argc, char *argv[])
+{
+    /* Get notified (instead of being killed) when closed from the HOME menu. */
+    appletLockExit();
+    set_exit_mode();
+    if (argc > 0 && argv[0])
+        snprintf(g_self_path, sizeof(g_self_path), "%s", argv[0]);
+
+    g_screen = malloc((size_t)KO_FB_WIDTH * KO_FB_HEIGHT * 4);
+    if (!g_screen || ko_fb_init() != 0) {
+        free(g_screen);
+        g_screen = NULL;
+    }
+    show_splash("Loading...");
+
+    mkdir("sdmc:/switch", 0777);
+    mkdir(KO_HOME, 0777);
+
+    if (R_SUCCEEDED(romfsInit())) {
+        bool ok = true;
+        if (ko_install_needed(KO_ROMFS, KO_HOME)) {
+            u64 last_update = 0;
+            show_splash("Installing...");
+            ok = ko_install(KO_ROMFS, KO_HOME, on_install_progress, &last_update);
+        }
+        romfsExit();
+        if (!ok) {
+            show_fatal_error("Could not install KOReader to the SD card (is it full?).");
+            appletUnlockExit();
+            return EXIT_FAILURE;
+        }
+        show_splash("Loading...");
+    }
+
+    if (chdir(KO_HOME) != 0 || access("reader.lua", F_OK) != 0) {
+        show_fatal_error("KOReader is not installed in /switch/koreader.");
+        appletUnlockExit();
+        return EXIT_FAILURE;
+    }
+
+    setup_logging();
+    setup_timezone();
+    /* Point TLS certificate verification at the bundle we ship (there's no system CA store). */
+    setenv("TURBO_CAPATH", KO_HOME "/data/ca-bundle.crt", 1);
+    setenv("CURL_CA_BUNDLE", KO_HOME "/data/ca-bundle.crt", 1);
+    setenv("SSL_CERT_FILE", KO_HOME "/data/ca-bundle.crt", 1);
+    psmInitialize();
+    lblInitialize();
+    nifmInitialize(NifmServiceType_User);
+    socketInitializeDefault();
+    ko_input_init();
+
+    pthread_attr_t attr;
+    pthread_t thread;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, KO_LUA_STACK_SIZE);
+    if (pthread_create(&thread, &attr, run_koreader, NULL) == 0)
+        pthread_join(thread, NULL);
+    else
+        run_koreader(NULL);
+    pthread_attr_destroy(&attr);
+
+    socketExit();
+    nifmExit();
+    lblExit();
+    psmExit();
+    ko_fb_close();
+    free(g_screen);
+    set_exit_mode();
+    /* Release the exit lock taken at startup, so the process can actually terminate (→ HOME menu). */
+    appletUnlockExit();
+    fprintf(stderr, "KOReader: main() returning, status=%d, applet_exit_mode=%u\n",
+            g_exit_status, (unsigned)__nx_applet_exit_mode);
+    fflush(NULL);
+    return g_exit_status;
+}

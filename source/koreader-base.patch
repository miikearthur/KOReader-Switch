diff --git a/switch/compat/readv.c b/switch/compat/readv.c
new file mode 100644
index 00000000..749ee2a5
--- /dev/null
+++ b/switch/compat/readv.c
@@ -0,0 +1,32 @@
+/* `readv` / `writev`, emulated with `read` / `write`. */
+
+#include <sys/uio.h>
+#include <unistd.h>
+
+ssize_t readv(int fd, const struct iovec *iov, int iovcnt)
+{
+    ssize_t total = 0;
+    for (int i = 0; i < iovcnt; i++) {
+        ssize_t n = read(fd, iov[i].iov_base, iov[i].iov_len);
+        if (n < 0)
+            return total ? total : -1;
+        total += n;
+        if ((size_t)n < iov[i].iov_len)
+            break;
+    }
+    return total;
+}
+
+ssize_t writev(int fd, const struct iovec *iov, int iovcnt)
+{
+    ssize_t total = 0;
+    for (int i = 0; i < iovcnt; i++) {
+        ssize_t n = write(fd, iov[i].iov_base, iov[i].iov_len);
+        if (n < 0)
+            return total ? total : -1;
+        total += n;
+        if ((size_t)n < iov[i].iov_len)
+            break;
+    }
+    return total;
+}
diff --git a/switch/compat/rename.c b/switch/compat/rename.c
new file mode 100644
index 00000000..683f4ca9
--- /dev/null
+++ b/switch/compat/rename.c
@@ -0,0 +1,41 @@
+/*
+    File rename: emulate the POSIX "replace an existing destination" semantics that KOReader and its
+    plugins rely on. Horizon's filesystem refuses to rename onto an existing path (fsFsRenameFile
+    reports an error that surfaces as EEXIST), so a plain rename() over an existing file fails. That
+    breaks the ubiquitous atomic-save pattern of writing a temp file and renaming it over the target
+    (e.g. LuaSettings, and BookOrbit's sync-state flush and post-download bookkeeping).
+
+    We wrap newlib's reentrant `_rename_r`, the single chokepoint: the public `rename()` calls it,
+    and so does an FFI `C.rename`. Only a failure whose destination is an existing plain file is
+    recovered, and only when the source itself still exists, so a rename that failed for any other
+    reason never deletes whatever sits at the target. This is best-effort rather than atomic -- FAT
+    cannot replace atomically anyway -- but it restores the behaviour callers expect.
+    (Wired in with `-Wl,--wrap=_rename_r`.)
+*/
+
+#include <errno.h>
+#include <reent.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+
+int __real__rename_r(struct _reent *r, const char *old, const char *new);
+
+int __wrap__rename_r(struct _reent *r, const char *old, const char *new)
+{
+    int ret = __real__rename_r(r, old, new);
+    if (ret == 0 || strcmp(old, new) == 0) {
+        return ret;
+    }
+
+    /* Recover only from "the destination already exists": require the source to be present and the
+       destination to be a plain file, so an unrelated failure can never destroy the target. */
+    struct stat src_st, dst_st;
+    if (stat(old, &src_st) == 0 && stat(new, &dst_st) == 0 && !S_ISDIR(dst_st.st_mode)) {
+        if (remove(new) == 0) {
+            r->_errno = 0;
+            ret = __real__rename_r(r, old, new);
+        }
+    }
+    return ret;
+}
diff --git a/switch/compat/rmdir.c b/switch/compat/rmdir.c
new file mode 100644
index 00000000..bef2dd15
--- /dev/null
+++ b/switch/compat/rmdir.c
@@ -0,0 +1,34 @@
+/*
+    Directory removal: refuse a non-empty directory ourselves (returning ENOTEMPTY) instead of
+    asking the filesystem to remove it. Horizon returns an error for a non-empty directory anyway,
+    but doing the check here also keeps emulators whose host-backed filesystem aborts, instead of
+    returning that error, from crashing.
+
+    We wrap newlib's reentrant `_rmdir_r`, which is the single chokepoint: the public `rmdir()`
+    calls it, and so does `remove()` (hence `os.remove(dir)`) once `unlink` fails on a directory.
+    (Wired in with `-Wl,--wrap=_rmdir_r`.)
+*/
+
+#include <dirent.h>
+#include <errno.h>
+#include <reent.h>
+#include <string.h>
+
+int __real__rmdir_r(struct _reent *r, const char *path);
+
+int __wrap__rmdir_r(struct _reent *r, const char *path)
+{
+    DIR *d = opendir(path);
+    if (d) {
+        struct dirent *e;
+        while ((e = readdir(d)) != NULL) {
+            if (strcmp(e->d_name, ".") != 0 && strcmp(e->d_name, "..") != 0) {
+                closedir(d);
+                r->_errno = ENOTEMPTY;
+                return -1;
+            }
+        }
+        closedir(d);
+    }
+    return __real__rmdir_r(r, path);
+}

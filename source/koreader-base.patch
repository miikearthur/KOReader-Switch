diff --git a/ffi/framebuffer_switch.lua b/ffi/framebuffer_switch.lua
new file mode 100644
index 00000000..776cdb1a
--- /dev/null
+++ b/ffi/framebuffer_switch.lua
@@ -0,0 +1,77 @@
+--[[--
+Framebuffer implementation for Nintendo Switch homebrew (libnx).
+
+The panel is 1280x720 (landscape). We draw into a BBRGB32 buffer, which has the
+same memory layout as the libnx framebuffer (RGBA8888), and present it with a
+straight copy. The UI is meant to be used in portrait, with the console held
+sideways like a book: the device sets `is_always_portrait`, so the buffer is
+rotated by the generic framebuffer code (and touch input accordingly).
+
+@module ffi.framebuffer_switch
+--]]
+
+local BB = require("ffi/blitbuffer")
+local ffi = require("ffi")
+local C = ffi.C
+
+require("ffi/switch_h")
+
+local framebuffer = {
+    painting = false,
+    dirty = false,
+    hw_nightmode = false,
+}
+
+function framebuffer:init()
+    if C.ko_fb_init() ~= 0 then
+        error("cannot initialize the framebuffer")
+    end
+    self.bb = BB.new(C.KO_FB_WIDTH, C.KO_FB_HEIGHT, BB.TYPE_BBRGB32)
+    self.bb:fill(BB.COLOR_WHITE)
+    -- NOTE: nothing is presented until the first refresh, so the launcher's splash screen stays up meanwhile.
+    framebuffer.parent.init(self)
+end
+
+-- Night mode is done at scan-out (a full-frame XOR in ko_fb_present), so the device advertises
+-- canHWInvert and KOReader keeps drawing normal, non-inverted pixels. That matters for speed: the
+-- software-inversion path (dest buffer flagged inverse, sources not) bypasses the C blitter and falls
+-- back to a per-pixel Lua blit, which is punishingly slow without LuaJIT's JIT.
+function framebuffer:setHWNightmode(toggle)
+    self.hw_nightmode = toggle and true or false
+end
+
+function framebuffer:getHWNightmode()
+    return self.hw_nightmode
+end
+
+function framebuffer:_present()
+    self.dirty = false
+    local bb = self.full_bb or self.bb
+    -- Rotation is just a view: the memory is always laid out in the panel's native orientation.
+    C.ko_fb_present(ffi.cast("const uint8_t *", bb.data), bb.pixel_stride, self.hw_nightmode and 1 or 0)
+end
+
+-- The whole frame is presented at once, so coalesce the refreshes of a paint batch.
+function framebuffer:beforePaint()
+    self.painting = true
+end
+
+function framebuffer:afterPaint()
+    self.painting = false
+    if self.dirty then
+        self:_present()
+    end
+end
+
+function framebuffer:refreshFullImp(x, y, w, h) -- luacheck: ignore
+    self.dirty = true
+    if not self.painting then
+        self:_present()
+    end
+end
+
+function framebuffer:close()
+    -- NOTE: the launcher tears down the framebuffer on exit (and may still need it to report errors).
+end
+
+return require("ffi/framebuffer"):extend(framebuffer)
diff --git a/ffi/input_switch.lua b/ffi/input_switch.lua
new file mode 100644
index 00000000..6e9baa8f
--- /dev/null
+++ b/ffi/input_switch.lua
@@ -0,0 +1,60 @@
+--[[--
+Input implementation for Nintendo Switch homebrew (libnx).
+
+The port is operated with the touch screen only. Events are translated to
+<linux/input.h> events by the native glue (c.f., `switch/input.c`):
+multi-touch protocol B for the touch screen, and EV_SDL for platform events
+(exit request, docking…).
+
+@module ffi.input_switch
+--]]
+
+local ffi = require("ffi")
+local C = ffi.C
+
+require("ffi/posix_h")
+require("ffi/linux_input_h")
+require("ffi/switch_h")
+
+local MAX_EVENTS = 128
+local events = ffi.new("ko_input_event[?]", MAX_EVENTS)
+
+local input = {
+    -- NOPs
+    open = function() end,
+    close = function() end,
+    closeAll = function() end,
+    fakeTapInput = function() end,
+    -- Tell front that we're a custom imp with no concept of paths/fd
+    is_ffi = true,
+}
+
+function input.waitForEvent(sec, usec)
+    local timeout_ms = -1
+    if sec then
+        -- Round up, so we don't busy loop on sub-millisecond timeouts.
+        timeout_ms = math.ceil(sec * 1000 + usec / 1000)
+    end
+    local count = C.ko_input_poll(events, MAX_EVENTS, timeout_ms)
+    if count <= 0 then
+        return false, C.ETIME
+    end
+    local queue = {}
+    for i = 0, count - 1 do
+        local ev = events[i]
+        queue[i + 1] = {
+            type = tonumber(ev.type),
+            code = tonumber(ev.code),
+            value = tonumber(ev.value),
+            time = {
+                sec = tonumber(ev.sec),
+                usec = tonumber(ev.usec),
+            },
+        }
+    end
+    return true, queue
+end
+
+C.ko_input_init()
+
+return input

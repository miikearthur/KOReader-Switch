new file mode 100644
index 00000000..d442a667
--- /dev/null
+++ b/switch/include/endian.h
@@ -0,0 +1,48 @@
+/* KOReader for Nintendo Switch: <endian.h> (newlib only provides <machine/endian.h>). */
+
+#ifndef KOSWITCH_ENDIAN_H
+#define KOSWITCH_ENDIAN_H
+
+#include <machine/endian.h>
+
+#ifndef LITTLE_ENDIAN
+# define LITTLE_ENDIAN _LITTLE_ENDIAN
+#endif
+#ifndef BIG_ENDIAN
+# define BIG_ENDIAN _BIG_ENDIAN
+#endif
+#ifndef PDP_ENDIAN
+# define PDP_ENDIAN _PDP_ENDIAN
+#endif
+#ifndef BYTE_ORDER
+# define BYTE_ORDER _BYTE_ORDER
+#endif
+
+#if _BYTE_ORDER == _LITTLE_ENDIAN
+# define KOSWITCH_TO_LE(bits, x) ((__uint##bits##_t)(x))
+# define KOSWITCH_TO_BE(bits, x) __builtin_bswap##bits(x)
+#else
+# define KOSWITCH_TO_LE(bits, x) __builtin_bswap##bits(x)
+# define KOSWITCH_TO_BE(bits, x) ((__uint##bits##_t)(x))
+#endif
+
+#ifndef htobe16
+# define htobe16(x) KOSWITCH_TO_BE(16, x)
+# define htole16(x) KOSWITCH_TO_LE(16, x)
+# define be16toh(x) KOSWITCH_TO_BE(16, x)
+# define le16toh(x) KOSWITCH_TO_LE(16, x)
+#endif
+#ifndef htobe32
+# define htobe32(x) KOSWITCH_TO_BE(32, x)
+# define htole32(x) KOSWITCH_TO_LE(32, x)
+# define be32toh(x) KOSWITCH_TO_BE(32, x)
+# define le32toh(x) KOSWITCH_TO_LE(32, x)
+#endif
+#ifndef htobe64
+# define htobe64(x) KOSWITCH_TO_BE(64, x)
+# define htole64(x) KOSWITCH_TO_LE(64, x)
+# define be64toh(x) KOSWITCH_TO_BE(64, x)
+# define le64toh(x) KOSWITCH_TO_LE(64, x)
+#endif
+
+#endif
diff --git a/switch/include/netinet/in.h b/switch/include/netinet/in.h
new file mode 100644
index 00000000..b359507a
--- /dev/null
+++ b/switch/include/netinet/in.h
@@ -0,0 +1,31 @@
+/*
+    KOReader for Nintendo Switch: libnx's <netinet/in.h>, plus:
+    - the byte order functions (`htons` & co), which libnx only provides in <arpa/inet.h>,
+      while other C libraries also make them available here;
+    - a few missing IPv6 bits.
+*/
+
+#ifndef KOSWITCH_NETINET_IN_H
+#define KOSWITCH_NETINET_IN_H
+
+#include_next <netinet/in.h>
+#include <arpa/inet.h>
+
+/* NOTE: `struct in6_addr` wraps an (anonymous) union whose first member is `uint16_t[8]`. */
+#ifndef IN6ADDR_ANY_INIT
+# define IN6ADDR_ANY_INIT { { { 0, 0, 0, 0, 0, 0, 0, 0 } } }
+#endif
+#ifndef IN6ADDR_LOOPBACK_INIT
+# if _BYTE_ORDER == _LITTLE_ENDIAN
+#  define IN6ADDR_LOOPBACK_INIT { { { 0, 0, 0, 0, 0, 0, 0, 0x0100 } } }
+# else
+#  define IN6ADDR_LOOPBACK_INIT { { { 0, 0, 0, 0, 0, 0, 0, 0x0001 } } }
+# endif
+#endif
+
+struct ipv6_mreq {
+    struct in6_addr ipv6mr_multiaddr;
+    unsigned int ipv6mr_interface;
+};
+
+#endif

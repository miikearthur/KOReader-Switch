+        return -1;
+    }
+    if (csrng_available < 0)
+        csrng_available = R_SUCCEEDED(csrngInitialize());
+    if (!csrng_available || R_FAILED(csrngGetRandomBytes(buf, len)))
+        randomGet(buf, len);
+    return 0;
+}

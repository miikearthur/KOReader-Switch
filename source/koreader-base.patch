+    (void)path;
+    (void)owner;
+    (void)group;
+    return 0;
+}
+
+int fchown(int fd, uid_t owner, gid_t group)
+{
+    (void)fd;
+    (void)owner;
+    (void)group;
+    return 0;
+}
diff --git a/switch/compat/dirname.c b/switch/compat/dirname.c
new file mode 100644
index 00000000..e083526c
--- /dev/null
+++ b/switch/compat/dirname.c
@@ -0,0 +1,24 @@
+/* POSIX `dirname` (may modify its argument). */
+
+#include <stddef.h>
+
+char *dirname(char *path)
+{
+    static char dot[] = ".";
+    if (!path || !*path)
+        return dot;
+    size_t len = __builtin_strlen(path);
+    while (len > 1 && path[len - 1] == '/')
+        path[--len] = '\0';
+    char *slash = __builtin_strrchr(path, '/');
+    if (!slash)
+        return dot;
+    while (slash > path && slash[-1] == '/')
+        slash--;
+    if (slash == path) {
+        path[1] = '\0';
+        return path;
+    }
+    *slash = '\0';
+    return path;
+}

diff --git a/switch/device.c b/switch/device.c
new file mode 100644
index 00000000..4b77b4af
--- /dev/null
+++ b/switch/device.c
@@ -0,0 +1,139 @@
+/*
+    KOReader for Nintendo Switch: display & device services.
+*/
+
+#include <switch.h>
+
+#include <string.h>
+
+#include "koswitch.h"
+
+/* -- Framebuffer ------------------------------------------------------------ */
+
+static Framebuffer g_fb;
+static bool g_fb_ready;
+
+int ko_fb_init(void)
+{
+    if (g_fb_ready)
+        return 0;
+    Result rc = framebufferCreate(&g_fb, nwindowGetDefault(), KO_FB_WIDTH, KO_FB_HEIGHT, PIXEL_FORMAT_RGBA_8888, 2);
+    if (R_FAILED(rc))
+        return -1;
+    /* The GPU buffers are laid out in block-linear order: draw into a linear shadow buffer, which libnx converts. */
+    if (R_FAILED(framebufferMakeLinear(&g_fb))) {
+        framebufferClose(&g_fb);
+        return -1;
+    }
+    g_fb_ready = true;
+    return 0;
+}
+
+void ko_fb_close(void)
+{
+    if (g_fb_ready) {
+        framebufferClose(&g_fb);
+        g_fb_ready = false;
+    }
+}
+
+/*
+    Present a full frame. `pixels` points to a 1280x720 RGBA8888 buffer (i.e., KOReader's
+    BBRGB32 layout) laid out in the panel's native (landscape) orientation, `stride` is in
+    pixels (the shadow buffer's is in bytes). Rotation is handled by the blitbuffer itself,
+    inversion (night mode) here.
+*/
+__attribute__((optimize("O3")))
+void ko_fb_present(const uint8_t *pixels, int stride, int invert)
+{
+    if (!g_fb_ready || !pixels)
+        return;
+    u32 dst_stride;
+    uint8_t *dst = framebufferBegin(&g_fb, &dst_stride);
+    const u32 mask = invert ? 0x00ffffffu : 0;
+    const u32 alpha = 0xff000000u;
+    for (int y = 0; y < KO_FB_HEIGHT; y++) {
+        const uint8_t *s = pixels + (size_t)y * (size_t)stride * 4;
+        uint8_t *d = dst + (size_t)y * dst_stride;
+        for (int x = 0; x < KO_FB_WIDTH * 4; x += 4) {
+            u32 v;
+            memcpy(&v, s + x, 4);
+            v = (v ^ mask) | alpha;
+            memcpy(d + x, &v, 4);
+        }
+    }
+    framebufferEnd(&g_fb);
+}
+
+/* -- Device ----------------------------------------------------------------- */
+
+int ko_get_product_model(void)
+{
+    SetSysProductModel model = SetSysProductModel_Invalid;
+    if (R_SUCCEEDED(setsysInitialize())) {
+        if (R_FAILED(setsysGetProductModel(&model)))
+            model = SetSysProductModel_Invalid;
+        setsysExit();
+    }
+    return model;
+}
+
+int ko_is_applet_mode(void)
+{
+    AppletType type = appletGetAppletType();
+    return type != AppletType_Application && type != AppletType_SystemApplication;
+}
+
+int ko_get_operation_mode(void)
+{
+    return appletGetOperationMode();
+}
+
+int ko_get_battery_percentage(void)
+{
+    u32 percentage;
+    if (R_FAILED(psmGetBatteryChargePercentage(&percentage)))
+        return -1;
+    return percentage;
+}
+
+int ko_is_charging(void)
+{
+    PsmChargerType type;
+    if (R_FAILED(psmGetChargerType(&type)))
+        return 0;
+    return type != PsmChargerType_Unconnected;
+}
+
+float ko_get_brightness(void)
+{
+    float value;
+    if (R_FAILED(lblGetCurrentBrightnessSetting(&value)))
+        return -1.0f;
+    return value;
+}
+
+int ko_set_brightness(float value)
+{
+    if (value < 0.0f)
+        value = 0.0f;
+    if (value > 1.0f)
+        value = 1.0f;
+    return R_SUCCEEDED(lblSetCurrentBrightnessSetting(value)) ? 0 : -1;
+}
+
+int ko_is_network_connected(void)
+{
+    NifmInternetConnectionType type;
+    NifmInternetConnectionStatus status;
+    u32 strength;
+    if (R_FAILED(nifmGetInternetConnectionStatus(&type, &strength, &status)))
+        return 0;
+    return status == NifmInternetConnectionStatus_Connected;
+}
+
+void ko_set_auto_sleep_inhibited(int inhibited)
+{
+    /* Same as video players: prevents screen dimming & auto-sleep while reading. */
+    appletSetMediaPlaybackState(inhibited != 0);
+}
diff --git a/switch/gen_symtab.py b/switch/gen_symtab.py
new file mode 100644
index 00000000..47e361e9
--- /dev/null
+++ b/switch/gen_symtab.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""
+Linker launcher for the Nintendo Switch executable.
+
+There is no dynamic loader on Horizon, so everything is statically linked,
+and LuaJIT's FFI (`ffi.C.xxx`, `ffi.load(…)`) as well as `require` of Lua C
+modules resolve their symbols through a table generated here:
+
+1. collect candidate symbols from the ffi-cdecl files (`cdecl_func(…)` and
+   `cdecl_var(…)` entries), plus some extra lists;
+2. keep only the ones actually defined by the link inputs (objects, static
+   libraries, and the toolchain's default libraries);
+3. compile the table, and add it to the link command, which is then run.
+
+Usage:
+    gen_symtab.py --nm NM --cdecls FILE[;FILE…] -- LINK_COMMAND…
+"""
+
+import argparse
+import os
+import re
+import shlex
+import subprocess
+import sys
+
+
+CDECL_RX = re.compile(r'^\s*cdecl_(?:func|var)\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)', re.M)
+
+TOOLCHAIN_LIBS = (
+    'libc.a', 'libg.a', 'libm.a', 'libsysbase.a', 'libpthread.a',
+    'libstdc++.a', 'libsupc++.a', 'libgcc.a',
+)
+
+
+def expand_response_files(args):
+    out = []
+    for a in args:
+        if a.startswith('@') and os.path.isfile(a[1:]):
+            with open(a[1:]) as fp:
+                out.extend(expand_response_files(shlex.split(fp.read())))
+        else:
+            out.append(a)
+    return out
+
+
+def find_compiler(cmd):
+    for a in cmd:
+        base = os.path.basename(a)
+        if base.endswith(('gcc', 'g++', 'cc', 'c++')) and 'ccache' not in base:
+            return a
+    raise SystemExit('gen_symtab: cannot find compiler in link command')
+
+
+def link_inputs(cmd):
+    files, libdirs, libnames = [], [], []
+    it = iter(cmd)
+    for a in it:
+        if a == '-o':
+            next(it, None)
+        elif a.startswith('-L'):
+            libdirs.append(a[2:] or next(it, ''))
+        elif a.startswith('-l') and not a.startswith('-l:'):
+            libnames.append(a[2:])
+        elif a.endswith(('.a', '.o', '.obj')) and os.path.isfile(a):
+            files.append(a)
+    for name in libnames:
+        for d in libdirs:
+            p = os.path.join(d, 'lib%s.a' % name)
+            if os.path.isfile(p):
+                files.append(p)
+                break
+    return files
+
+
+def toolchain_libs(cc, cmd):
+    # Use the same multilib selection flags as the link.
+    flags = [a for a in cmd if a.startswith(('-m', '-specs=', '-fPIC', '-fpic', '-fPIE', '-fpie'))]
+    libs = []
+    for name in TOOLCHAIN_LIBS:
+        path = subprocess.check_output([cc] + flags + ['-print-file-name=' + name], text=True).strip()
+        if os.path.isabs(path) and os.path.isfile(path):
+            libs.append(path)
+    devkitpro = os.environ.get('DEVKITPRO')
+    if devkitpro:
+        libnx = os.path.join(devkitpro, 'libnx', 'lib', 'libnx.a')
+        if os.path.isfile(libnx):
+            libs.append(libnx)
+    return libs
+
+
+def defined_symbols(nm, files):
+    symbols = set()
+    for chunk in range(0, len(files), 64):
+        out = subprocess.run(
+            [nm, '-g', '--defined-only', '-P'] + files[chunk:chunk + 64],
+            check=True, capture_output=True, text=True,
+        ).stdout
+        for line in out.splitlines():
+            fields = line.split()
+            if len(fields) >= 2 and len(fields[1]) == 1 and fields[1] not in 'Uw':
+                symbols.add(fields[0])
+    return symbols
+
+
+def main():
+    argv = sys.argv[1:]
+    if '--' not in argv:
+        raise SystemExit(__doc__)
+    split = argv.index('--')
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--nm', required=True)
+    parser.add_argument('--cdecls', required=True)
+    parser.add_argument('--output', required=True)
+    # Libraries linked implicitly (e.g. through a specs file).
+    parser.add_argument('--extra-lib', action='append', default=[])
+    opts = parser.parse_args(argv[:split])
+    cmd = argv[split + 1:]
+    link_cmd = expand_response_files(cmd)
+
+    candidates = set()
+    with open(opts.cdecls, encoding='utf-8') as fp:
+        cdecl_files = [line.strip() for line in fp if line.strip()]
+    for f in cdecl_files:
+        with open(f, encoding='utf-8') as fp:
+            candidates.update(CDECL_RX.findall(fp.read()))
+
+    cc = find_compiler(link_cmd)
+    files = link_inputs(link_cmd) + toolchain_libs(cc, link_cmd) + [f for f in opts.extra_lib if os.path.isfile(f)]
+    defined = defined_symbols(opts.nm, files)
+    symbols = sorted(candidates & defined)
+
+    src = opts.output
+    obj = os.path.splitext(src)[0] + '.o'
+    with open(src, 'w') as fp:
+        fp.write('/* Generated by gen_symtab.py: do not edit. */\n\n')
+        fp.write('#include <stddef.h>\n\n')
+        fp.write('typedef struct { const char *name; void *addr; } ko_symbol;\n\n')
+        for n, s in enumerate(symbols):
+            fp.write('extern char ko_sym_%u __asm__("%s");\n' % (n, s))
+        fp.write('\nconst ko_symbol ko_symtab[] = {\n')
+        for n, s in enumerate(symbols):
+            fp.write('    { "%s", &ko_sym_%u },\n' % (s, n))
+        fp.write('};\n\nconst size_t ko_symtab_size = %u;\n' % len(symbols))
+    compile_flags = [a for a in link_cmd if a.startswith(('-m', '-fPIC', '-fpic', '-fPIE', '-fpie'))]
+    # NOTE: the link driver may be `g++`, which would compile the table as C++ (mangled, internal linkage).
+    subprocess.run([cc, '-x', 'c'] + compile_flags + ['-fno-builtin', '-w', '-c', src, '-o', obj], check=True)
+    missing = sorted(candidates - defined)
+    with open(os.path.splitext(src)[0] + '.missing', 'w') as fp:
+        fp.write('\n'.join(missing) + '\n')
+    print('gen_symtab: %u symbols (%u declared but not linked)' % (len(symbols), len(missing)))
+
+    # Insert the table object before the first library, so its references pull archive members.
+    pos = next((i for i, a in enumerate(cmd) if a.endswith('.a') or a.startswith(('-l', '-Wl,--start-group'))), len(cmd))
+    cmd = cmd[:pos] + [obj] + cmd[pos:]
+    os.execvp(cmd[0], cmd)
+
+
+if __name__ == '__main__':
+    main()

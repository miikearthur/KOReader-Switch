diff --git a/Makefile b/Makefile
index 6ea6cdbd..013ad3de 100644
--- a/Makefile
+++ b/Makefile
@@ -110,6 +110,53 @@ $(BASE_PREFIX)all $(LEFTOVERS): skeleton $(BUILD_ENTRYPOINT)
 
 # }}}
 
+# Nintendo Switch compatibility layer. {{{
+
+ifdef SWITCH
+
+SWITCH_COMPAT_OBJS = $(patsubst $(KOR_BASE)/switch/compat/%.c,$(SWITCH_COMPAT_DIR)/%.o,$(wildcard $(KOR_BASE)/switch/compat/*.c))
+SWITCH_COMPAT_LIB = $(SWITCH_COMPAT_DIR)/libkoswitch.a
+SWITCH_SPECS = $(SWITCH_COMPAT_DIR)/koswitch.specs
+
+# Same as libnx's `switch.specs`, but:
+# - only for executables (so thirdparty projects insisting on building a shared library don't fail),
+# - with our shims & libnx added to the libraries linked by default,
+# - with the POSIX `timezone` & `daylight` globals aliased to newlib's.
+define switch_specs
+%rename link koswitch_link
+
+*link:
+%(koswitch_link) %{!shared:-T $(DEVKITPRO)/libnx/switch.ld -pie --no-dynamic-linker --spare-dynamic-tags=0 --gc-sections -z text -z now -z nodynamic-undefined-weak -z pack-relative-relocs --build-id=sha1 --nx-module-name --defsym=timezone=_timezone --defsym=daylight=_daylight}
+
+*startfile:
+crti%O%s crtbegin%O%s %{!shared:--require-defined=main}
+
+%rename lib koswitch_lib
+
+*lib:
+%{!shared:-lkoswitch -lnx} %(koswitch_lib)
+
+endef
+
+$(SWITCH_COMPAT_DIR)/%.o: $(KOR_BASE)/switch/compat/%.c $(wildcard $(KOR_BASE)/switch/include/*.h $(KOR_BASE)/switch/include/*/*.h) | $(SWITCH_COMPAT_DIR)/
+	$(REALCC) $(CFLAGS) -Wall -c $< -o $@
+
+$(SWITCH_COMPAT_LIB): $(SWITCH_COMPAT_OBJS)
+	rm -f $@
+	$(AR) rcs $@ $^
+
+$(SWITCH_SPECS): $(KOR_BASE)/Makefile | $(SWITCH_COMPAT_DIR)/
+	$(call write_file,$@,$(switch_specs))
+
+$(BUILD_ENTRYPOINT): | $(SWITCH_COMPAT_LIB) $(SWITCH_SPECS)
+$(BASE_PREFIX)all $(LEFTOVERS): $(SWITCH_COMPAT_LIB) $(SWITCH_SPECS)
+
+SOUND += $(SWITCH_COMPAT_DIR)/%
+
+endif
+
+# }}}
+

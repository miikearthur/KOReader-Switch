diff --git a/switch/compat/archive_child.c b/switch/compat/archive_child.c
new file mode 100644
index 00000000..be8326e6
--- /dev/null
+++ b/switch/compat/archive_child.c
@@ -0,0 +1,26 @@
+/*
+    libarchive's "program" filters (e.g. `archive_read_support_filter_program`) run external
+    commands, which is impossible without `fork`/`exec`: its POSIX implementation of these
+    internal helpers isn't built, so provide failing versions.
+*/
+
+#include <errno.h>
+#include <sys/types.h>
+
+#define ARCHIVE_FAILED (-25)
+
+int __archive_create_child(const char *cmd, int *child_stdin, int *child_stdout, pid_t *out_child)
+{
+    (void)cmd;
+    (void)child_stdin;
+    (void)child_stdout;
+    (void)out_child;
+    errno = ENOSYS;
+    return ARCHIVE_FAILED;
+}
+
+void __archive_check_child(int in, int out)
+{
+    (void)in;
+    (void)out;
+}
diff --git a/switch/compat/basename.c b/switch/compat/basename.c
new file mode 100644
index 00000000..fdd6bda8
--- /dev/null
+++ b/switch/compat/basename.c
@@ -0,0 +1,23 @@
+/* POSIX & GNU `basename`. */
+
+#include <stddef.h>
+
+/* POSIX variant (may modify its argument). */
+char *basename(char *path)
+{
+    static char dot[] = ".";
+    if (!path || !*path)
+        return dot;
+    size_t len = __builtin_strlen(path);
+    while (len > 1 && path[len - 1] == '/')
+        path[--len] = '\0';
+    char *slash = __builtin_strrchr(path, '/');
+    return slash && slash[1] ? slash + 1 : path;
+}
+
+/* GNU variant (what `basename` maps to with `_GNU_SOURCE`): never modifies its argument. */
+char *__gnu_basename(const char *path)
+{
+    const char *slash = __builtin_strrchr(path, '/');
+    return (char *)(slash ? slash + 1 : path);
+}
diff --git a/switch/compat/byteorder.c b/switch/compat/byteorder.c
new file mode 100644
index 00000000..866b52ba
--- /dev/null
+++ b/switch/compat/byteorder.c
@@ -0,0 +1,27 @@
+/*
+    Byte order functions: libnx only provides them as static inline functions (in
+    <arpa/inet.h>), so there are no symbols for LuaJIT's FFI (`ffi.C.htons`) to use.
+    NOTE: don't include <arpa/inet.h> here, or the definitions would conflict.
+*/
+
+#include <stdint.h>
+
+uint32_t htonl(uint32_t hostlong)
+{
+    return __builtin_bswap32(hostlong);
+}
+
+uint16_t htons(uint16_t hostshort)
+{
+    return __builtin_bswap16(hostshort);
+}
+
+uint32_t ntohl(uint32_t netlong)
+{
+    return __builtin_bswap32(netlong);
+}
+
+uint16_t ntohs(uint16_t netshort)
+{
+    return __builtin_bswap16(netshort);
+}
